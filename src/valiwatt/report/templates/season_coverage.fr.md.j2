{# La phrase sur la couverture par saison, rendue des intervalles du run ; voir report/validation.py::season_coverage. #}
{% set IN = {'winter': 'en hiver', 'spring': 'au printemps', 'summer': 'en été', 'fall': 'en automne'} %}
{% macro among(keys) %}{% for k in keys %}{{ IN[k] }}{% if loop.revindex == 2 %} et {% elif not loop.last %}, {% endif %}{% endfor %}{% endmacro %}
{% macro season_sentence(rows, nominal) %}
{% set inside = rows|selectattr('contains_nominal')|map(attribute='key')|list %}
{% set outside = rows|rejectattr('contains_nominal')|map(attribute='key')|list %}
{% set apart = rows|selectattr('disjoint')|map(attribute='key')|list %}
{% set overlap = rows|rejectattr('disjoint')|map(attribute='key')|list %}
{% if not outside %}Avec un quantile par saison, l'IC 95 % de la couverture contient le nominal de {{ nominal|pct(0) }} dans chaque saison.{% elif not inside %}Avec un quantile par saison, l'IC 95 % de la couverture ne contient le nominal de {{ nominal|pct(0) }} dans aucune saison.{% else %}Avec un quantile par saison, l'IC 95 % de la couverture contient le nominal de {{ nominal|pct(0) }} {{ among(inside) }}, pas {{ among(outside) }}.{% endif %} {% if not overlap %}Dans chaque saison, les IC des deux formes ne se chevauchent pas.{% elif not apart %}Les IC des deux formes se chevauchent dans chaque saison.{% else %}Les IC des deux formes ne se chevauchent pas {{ among(apart) }} ; ils se chevauchent {{ among(overlap) }}.{% endif %} Aucun intervalle n'est calculé sur l'écart entre les deux formes : la comparaison s'arrête au chevauchement des IC.
{%- endmacro %}
