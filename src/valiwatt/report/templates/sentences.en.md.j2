{# The validation report's sentences that depend on the results: each branch says only what its data show. The
   computations are in report/validation.py (derive); tests/test_report_sentences.py walks the branches. #}
{% set pct_sign = '%' %}
{% macro sp(x, d=1) %}{{ (100 * x)|signed(d) }}{{ pct_sign }}{% endmacro %}
{% set MONTH = {1: 'January', 2: 'February', 3: 'March', 4: 'April', 5: 'May', 6: 'June', 7: 'July', 8: 'August', 9: 'September', 10: 'October', 11: 'November', 12: 'December'} %}
{% set THE_SEASON = {'winter': 'winter', 'spring': 'spring', 'summer': 'summer', 'fall': 'fall'} %}
{% set FAIL = {'mape_high': 'MAPE', 'bias_high': 'the bias, high side', 'bias_low': 'the bias, low side'} %}
{# The evaluation labels, the states and the verdicts of the decision rule (forecast/evaluate.py), read from the runs
   and named here. #}
{% set LABEL = {'in_sample_for_choice': 'in sample for the choice of family and input', 'in_sample_training': "in sample: the frozen model's own training rows", 'rehearsal': 'rehearsal on a design year', 'seen_by_developers': 'seen by the developers', 'held_out': 'held-out data', 'post_hoc': 'post hoc'} %}
{% set STATE = {'better': 'better', 'not_separated': 'not separated', 'worse': 'worse'} %}
{% set VERDICT = {'better': 'better', 'better_cold_untested': 'better on average, the cold tail untestable', 'not_shown_better': 'not shown better', 'worse': 'worse'} %}
{% set MODEL = {'gam_forecast': 'v2, the GAM on the forecast (production)', 'forecast': "v1's form on the forecast", 'persistence': "v1 as shipped (the day before's weather)", 'gam_observed': 'the GAM on observed weather (optimistic bound)', 'observed': "v1's form on observed weather (optimistic bound)", 'gam_forecast_late': 'the GAM, a longer availability margin (sensitivity)', 'baseline': 'same hour, one week earlier (naive baseline)'} %}
{% set COMPARISON = {'shipped': 'v2 against v1 as shipped', 'family': "v2 against v1's form on the same forecast", 'input': "v1's form on the forecast against v1 as shipped"} %}
{% set STAGE = {'opened': 'the opening of the run', 'inputs_read': 'the reading of its inputs', 'replayed': 'the replay', 'checked': 'the checks', 'logged': 'the logging of the results', '': 'no stage recorded'} %}
{% set OUTCOME = {'clean': 'clean', 'post_hoc': 'post hoc'} %}
{% macro label(l) %}_{{ LABEL[l] }}_{% endmacro %}
{# The years of the choice: an advantage of v2 is said there only when v2 has the lowest error of the three. #}
{% macro choice_bias(sel) %}{% if sel.mape[sel.models.production] < sel.mape[sel.models.family] and sel.mape[sel.models.production] < sel.mape[sel.models.shipped] %}v2's advantage there is biased upward by that choice, and it does not prove v2 better{% else %}even there, v2 does not have the lowest error of the three, which counts against it{% endif %}{% endmacro %}
{% macro and_list(items) %}{% for x in items %}{{ x }}{% if loop.revindex == 2 %} and {% elif not loop.last %}, {% endif %}{% endfor %}{% endmacro %}
{% macro months(ms) %}{% set names = [] %}{% for m in ms %}{% set _ = names.append(MONTH[m]) %}{% endfor %}{{ and_list(names) }}{% endmacro %}
{% macro groups(seasons, deciles, hours=[]) %}{% set parts = [] %}{% set names = [] %}{% for s in seasons %}{% set _ = names.append(THE_SEASON[s]) %}{% endfor %}{% if seasons %}{% set _ = parts.append(and_list(names)) %}{% endif %}{% if hours %}{% set _ = parts.append(('hour block ' if hours|length == 1 else 'hour blocks ') ~ and_list(hours)) %}{% endif %}{% if deciles %}{% set _ = parts.append(('forecast-load decile ' if deciles|length == 1 else 'forecast-load deciles ') ~ and_list(deciles)) %}{% endif %}{{ parts|join('; ') }}{% endmacro %}
{# The model card's status (plan section 8.5), from evaluate.status on the 2025 test of record alone: each wording
   names its scope. "Better on average, the cold tail untestable" counts as better, and the sentence says so. #}
{% macro cold_clause(status, record, held) %}{% set which = [] %}{% if record and record.verdict and record.verdict.shipped == 'better_cold_untested' %}{% set _ = which.append('of the comparison with v1 as shipped') %}{% endif %}{% if status == 'confirmed' and record and record.verdict and record.verdict.family == 'better_cold_untested' %}{% set _ = which.append("of the comparison with v1's form on the same forecast") %}{% endif %}{% if which %} "Better on average, the cold tail untestable" counts as better, and it is the verdict {{ and_list(which) }}: {{ held }}'s cold tail was not testable.{% endif %}{% endmacro %}
{% macro status_line(status, record, say, years, seen, held) %}{% if status == 'candidate' %}**Status: candidate.** Chosen on {{ years[0] }}–{{ years[1] }} (in sample for the choice), shown on {{ seen }} seen by the developers; the test on held-out data, {{ held }}, is pending.{% elif status == 'confirmed' %}**Status: lower hourly error than v1 as shipped and than v1's form on the same forecast, {{ say.held_out }}.**{{ cold_clause(status, record, held) }}{% elif status == 'input_only' %}**Status: lower hourly error than v1 as shipped {{ say.held_out }}; the GAM not shown better than v1's form on the same forecast.**{{ cold_clause(status, record, held) }}{% elif status == 'not_confirmed' %}**Status: not shown to have lower hourly error than v1 as shipped {{ say.held_out }}.**{% elif status == 'post_hoc' %}**Status: {{ held }} replayed under the owner's ruling that it is post hoc: not a held-out test.**{% elif status == 'unfinished' %}**Status: the {{ held }} test of record did not finish: no claim on held-out data.**{% else %}{{ unknown_status }}{% endif %}{% endmacro %}
{# The claims a clean 2025 that does not confirm v2 withdraws, named (plan section 8.5). #}
{% set CLAIM = {'shipped': 'that v2 has a lower hourly error than v1 as shipped', 'family': "that the GAM earns its place against v1's form on the same forecast"} %}
{% macro withdrawn(keys) %}{% set names = [] %}{% for k in keys %}{% set _ = names.append(CLAIM[k]) %}{% endfor %}{{ and_list(names) }}{% endmacro %}
{# Under- and over-coverage, on the bootstrap CIs as printed (report/validation.py::coverage_sides). `hour` carries the
   under- and over-covered hour blocks, named as their table names them; without it, the sentence speaks of seasons and
   deciles only, and says so. #}
{% macro coverage_sides(season, decile, nominal, hour=none) %}{% set hb = hour if hour is not none else {'under': [], 'over': []} %}{% if season.under or decile.under or hb.under %}Under-covered, their {{ design.ci_level|pct(0) }} CI wholly below the {{ nominal|pct(0) }} nominal: {{ groups(season.under, decile.under, hb.under) }}.{% elif hour is none %}No season and no load decile has its {{ design.ci_level|pct(0) }} CI wholly below the {{ nominal|pct(0) }} nominal.{% else %}No season, no hour block and no load decile has its {{ design.ci_level|pct(0) }} CI wholly below the {{ nominal|pct(0) }} nominal.{% endif %} {% if season.over or decile.over or hb.over %}Over-covered, the CI wholly above: {{ groups(season.over, decile.over, hb.over) }}.{% elif hour is none %}No group (season or load decile) has its CI wholly above.{% else %}No group (season, hour block or load decile) has its CI wholly above.{% endif %}{% endmacro %}
{# What a replay's power table shows (report/validation.py::detection_limits). #}
{% macro power_limit(L, year, horizon) %}{% if L.every_from is not none %}On {{ year }}, a sustained gap of ±{{ L.every_from|pct(0) }} or more between demand and forecast yielded "retrain" within {{ horizon }} weeks at each of the {{ L.starts }} starts{% else %}On {{ year }}, even the largest gap measured between demand and forecast, ±{{ L.sizes[-1]|pct(0) }}, did not yield "retrain" within {{ horizon }} weeks at every one of the {{ L.starts }} starts{% endif %}; a gap of +{{ L.smallest|pct(0) }} did at {{ L.smallest_by_sign.up.caught }} of {{ L.smallest_by_sign.up.cases }} starts, and of −{{ L.smallest|pct(0) }} at {{ L.smallest_by_sign.down.caught }} of {{ L.smallest_by_sign.down.cases }}. On {{ year }}, intervals cut to × {{ L.strongest|num(1) }} of their half-width yielded "recalibrate" at {{ L.strongest_caught.caught }} of {{ L.strongest_caught.cases }} starts{% if L.milder_max == 0 %}; no milder cut (up to × {{ L.mildest|num(1) }}) did{% elif L.milder_max is not none %}; milder cuts (up to × {{ L.mildest|num(1) }}) at most at {{ L.milder_max }} of {{ L.half_width_starts }} starts{% endif %}.{% endmacro %}
{# One week, as the monitor judges it. #}
{% macro week_ev(w) %}MAPE {{ w.stats.mape|pct(2) }}{% if w.flags.mape_high %} above its threshold{% endif %}, bias {{ sp(w.stats.rel_bias, 2) }}{% if w.flags.bias_high or w.flags.bias_low %} outside its band{% endif %}{% endmacro %}
{% macro stat(failure, x) %}{% if failure == 'mape_high' %}{{ x|pct(2) }}{% else %}{{ sp(x, 2) }}{% endif %}{% endmacro %}
{# The weeks where the first wording of rule 2 says "retrain", then why the rule kept did or did not
   (report/validation.py::near_misses). #}
{% macro near_list(items) %}{% for d in items %}in the week of {{ d.week_start|day }} (the week before: {{ week_ev(d.weeks[0]) }}; that week: {{ week_ev(d.weeks[1]) }}){% if not loop.last %}, then {% endif %}{% endfor %}{% endmacro %}
{% macro near_why(items, trim_days) %}{% for d in items %}{% if not loop.first %} {% endif %}Week of {{ d.week_start|day }}: {% if d.kept_by == 'fired' %}the rule kept said "retrain" too.{% elif d.kept_by == 'different' %}the two weeks do not show the same failure, and the rule kept sees nothing.{% elif d.kept_by == 'echo' %}MAPE is above its threshold, broad, in both weeks, but the bias leaves its band on one side and then the other: the rule kept sets it aside as an echo.{% else %}{% for s in d.same %}{{ FAIL[s.failure] }} is beyond its threshold in both weeks, but without each week's {{ trim_days }} most extreme days it is {{ stat(s.failure, s.trimmed[0]) }} then {{ stat(s.failure, s.trimmed[1]) }}{% if s.thresholds_equal %} against a threshold of {{ stat(s.failure, s.threshold) }}{% endif %}: {% if s.broad|select|list|length == 0 %}neither week is broadly beyond it{% else %}one of the two weeks is not broadly beyond it{% endif %}{% if not loop.last %}; {% endif %}{% endfor %}; so the rule kept sees nothing.{% if d.bias_flips and not d.bias_flagged %} The bias changes sign from one week to the next, but stays inside its band in both weeks: the echo exclusion is not what applies.{% endif %}{% endif %}{% endfor %}{% endmacro %}
{% macro pp(x, d=2) %}{{ (100 * x)|signed(d) }} pt{% endmacro %}
{% macro ppci(lo, hi, d=2) %}[{{ pp(lo, d) }}, {{ pp(hi, d) }}]{% endmacro %}
{% macro span(years) %}{{ years[0] }}–{{ years[1] }}{% endmacro %}
{% macro recs(n) %}{% if n == 0 %}no recommendation{% elif n == 1 %}{{ n }} recommendation{% else %}{{ n }} recommendations{% endif %}{% endmacro %}
{# The spring 2020 interval of the difference, with the Monte Carlo error of its bounds
   (report/validation.py::shift_difference, shift_verdict). #}
{% set BOUND = {'low': 'lower', 'high': 'upper'} %}
{% macro mc_se(x, d) %}{{ (100 * x)|num(d) }} pt{% endmacro %}
{% macro diff_verdict(d) %}{% if d.verdict == 'undetermined' %}undetermined at this resolution: the {{ BOUND[d.near.bound] }} bound{% if d.near.by == 'mc' %}, {{ pp(d.near.value, d.digits) }}, lies no more than {{ d.mc_multiple }} Monte Carlo standard errors ({{ mc_se(d.near.se, d.digits) }}) from zero{% else %} rounds to zero at a hundredth of a point{% endif %}, and section 1's rule does not decide{% elif d.verdict == 'confirmed' %}under section 1's rule, the gap is confirmed{% else %}under section 1's rule, the gap is not confirmed{% endif %} ({{ d.draws|num }} draws per side, in {{ d.batches }} independent batches of {{ d.batch_draws|num }}; Monte Carlo standard error of the bounds, measured by their spread from one batch to the next: {{ mc_se(d.mc_se_low, d.digits) }} and {{ mc_se(d.mc_se_high, d.digits) }}{% if d.verdict != 'undetermined' %}; bounds at this precision: {{ pp(d.ci95_low, d.digits) }} and {{ pp(d.ci95_high, d.digits) }}, each more than {{ d.mc_multiple }} of its standard errors from zero{% endif %}){% endmacro %}
{% macro spring_card(sh, d) %}{% if sh.separated %}a gap confirmed by disjoint intervals{% else %}a gap not confirmed by disjoint intervals{% endif %}; the interval of the difference {% if d.verdict == 'confirmed' %}confirms the gap{% elif d.verdict == 'not_confirmed' %}does not confirm the gap{% elif d.near.by == 'mc' %}does not decide at this resolution: a bound lies no more than {{ d.mc_multiple }} Monte Carlo standard errors from zero{% else %}does not decide at this resolution: a bound rounds to zero{% endif %}{% endmacro %}
{# `last_fold` and `hours` (the under-covered hour blocks, named as their table names them): the whole period and every
   table of section 5; without them, the sentence names only the start and speaks of seasons and deciles only. #}
{% macro brief_coverage(nominal, overall, first_fold, sides, last_fold=none, hours=none) %}Its {{ nominal|pct(0) }} intervals held demand {{ overall|pct(1) }} of the time {% if last_fold is not none %}from {{ first_fold }} to {{ last_fold }}{% else %}from {{ first_fold }} on{% endif %}{% if sides.overall.under %}, less than nominal, {{ design.ci_level|pct(0) }} CI included{% elif sides.overall.over %}, more than nominal, {{ design.ci_level|pct(0) }} CI included{% else %}, and the {{ design.ci_level|pct(0) }} CI of that coverage contains the nominal{% endif %}. {% set hb = hours if hours is not none else [] %}{% if sides.season.under or sides.decile.under or hb %}They hold it less often than the nominal in these groups: {{ groups(sides.season.under, sides.decile.under, hb) }} (section 5).{% elif hours is none %}No season and no load decile is under-covered in the sense of section 5.{% else %}No season and no load decile, nor any hour block, is under-covered in the sense of section 5.{% endif %}{% endmacro %}
{% macro brief_peak(peak, years, in_month, above) %}At the {{ peak.hours|length }} busiest hours of {{ span(years) }}{% if in_month %}, all in {{ peak.named_month }}{% endif %}, {% if peak.evaluated == 0 %}no prediction interval is computed{% elif peak.covered == peak.evaluated %}demand stayed inside the interval every time ({{ peak.evaluated }} hours judged){% else %}demand fell outside the interval {{ peak.evaluated - peak.covered }} times out of {{ peak.evaluated }}{% if above == peak.evaluated - peak.covered %}, always above it{% endif %}{% endif %}.{% endmacro %}
{# `power_horizon`: the power table's horizon, which is not the level shift's; without it, the sentence does not state
   it. #}
{% macro brief_misses(level, L, p_year, r_year, horizon, level24=none, power_horizon=none) %}The report also measures what the monitor could miss: on {{ p_year }}, a sustained {{ level.size|pct(0) }} rise in demand yielded "retrain" within {{ horizon }} weeks at {{ level.up_n - level.up_missed }} of {{ level.up_n }} starts{% if level24 %}, and on {{ r_year }} (seen by the developers), at {{ level24.up_n - level24.up_missed }} of {{ level24.up_n }}{% endif %}; on {{ r_year }}, a sustained gap of ±{{ L.smallest|pct(0) }} between demand and forecast{% if power_horizon is not none %} did within {{ power_horizon }} weeks at {{ L.smallest_by_sign.up.caught + L.smallest_by_sign.down.caught }} of {{ L.smallest_by_sign.up.cases + L.smallest_by_sign.down.cases }} cases{% else %} did at {{ L.smallest_by_sign.up.caught + L.smallest_by_sign.down.caught }} of {{ L.smallest_by_sign.up.cases + L.smallest_by_sign.down.cases }} cases{% endif %} (sections 7, 8 and 10).{% endmacro %}
{# Section 11: a break's result word, one for every break that passes whatever its label asserts, and the synthetic world's level shift set against section 10. #}
{% macro break_result(row) %}{% if row.outcome != 'passed' %}FAILED{% elif row.control %}stayed quiet{% else %}passed{% endif %}{% endmacro %}
{% macro level_shift_note(label, world, level, p_year, horizon) %}The break "{{ label }}" multiplies the synthetic world's demand by {{ (1 + world.level_shift)|num(2) }}, a {{ world.level_shift|pct(0) }} rise. {% if level.up_missed %}On the real {{ p_year }} hours, a {{ level.size|pct(0) }} rise did not yield "retrain" within {{ horizon }} weeks at {{ level.up_missed }} of {{ level.up_n }} starts (section 10): the rule can fire, but it did not see such a rise in real demand {% if level.up_missed == level.up_n %}at any start{% else %}at every start{% endif %}.{% else %}On the real {{ p_year }} hours, a {{ level.size|pct(0) }} rise yielded "retrain" within {{ horizon }} weeks at every start (section 10).{% endif %}{% endmacro %}
{% macro level_shift_note_replay(level, r_year, horizon) %}On the real {{ r_year }} hours (seen by the developers), {% if level.up_missed %}the same rise did not yield "retrain" within {{ horizon }} weeks at {{ level.up_missed }} of {{ level.up_n }} starts{% else %}the same rise yielded "retrain" within {{ horizon }} weeks at every start{% endif %} (section 10).{% endmacro %}
{# Section 6: the weeks set aside from the thresholds, counted by the validation run. Plural for 0. #}
{% macro set_aside(nx24, nx23, years24, years23, p_year) %}On these grounds {{ nx24 }} week{{ 's' if nx24 != 1 }} of {{ span(years24) }} {{ 'was' if nx24 == 1 else 'were' }} set aside ({{ nx23 }} of {{ span(years23) }} for the {{ p_year }} replay){% if nx24 or nx23 %}; the validation run lists each with its reason{% endif %}.{% endmacro %}
{# Section 10: the false alarms and blind spots measured on one year (report/validation.py::episode_limits,
   level_shift). #}
{% macro episode_limit(E, year, mild) %}on {{ year }}, {% if E.worst %}"retrain" at up to {{ E.share|pct(1) }} of starts ({{ E.worst.days }} days at × {{ E.worst.factor|num(2) }}) and at most {{ E.mild|pct(1) }} for an episode of ±{{ mild|pct(0) }}{% else %}no "retrain"{% endif %}, {% if E.recal_worst %}"recalibrate" at up to {{ E.recal_share|pct(1) }} of starts ({{ E.recal_worst.days }} days at × {{ E.recal_worst.factor|num(2) }}){% else %}no "recalibrate"{% endif %}{% endmacro %}
{% macro level_limit(level, year, horizon) %}On {{ year }}, {% if level.up_missed %}a sustained {{ level.size|pct(0) }} rise in demand did not yield "retrain" within {{ horizon }} weeks at {{ level.up_missed }} of {{ level.up_n }} starts (the {{ months(level.missed_months) }} start{{ 's' if level.up_missed > 1 }}), and a {{ level.size|pct(0) }} fall did at {{ level.down_caught }} of {{ level.down_n }}.{% else %}a sustained {{ level.size|pct(0) }} rise in demand yielded "retrain" within {{ horizon }} weeks at every start.{% endif %}{% endmacro %}
{% macro level_why(levels) %}{% set falls = [] %}{% for year, level in levels if level.up_missed and level.down_caught > level.up_n - level.up_missed %}{% set _ = falls.append(year) %}{% endfor %}{% set missed = [] %}{% for year, level in levels if level.up_missed %}{% set _ = missed.append(year) %}{% endfor %}{% if missed %}The demand lags absorb most of a rise.{% if falls %} {% endif %}{% endif %}{% if falls %}On {{ and_list(falls) }}, a fall yielded "retrain" more often than a rise: it leaves a larger relative gap than a rise of the same size, since the bias is measured against the lower demand; where the year's weekly bias sat within each season's band does the rest.{% endif %}{% endmacro %}
{# A replay's recommendations, as the ledger lists them. #}
{% set REC_WORD = {'retrain': 'retrain', 'recalibrate': 'recalibrate the intervals', 'investigate_data': 'investigate the data'} %}
{% macro recs_list(items) %}{% for x in items %}week of {{ x.week_start|day }}: {{ REC_WORD[x.recommendation] }}{% if not loop.last %}; {% endif %}{% else %}none{% endfor %}{% endmacro %}
{# The departure from v1's frozen rules, item by item (report/validation.py::DEPARTURE): v1's report described it; this
   file keeps it for a v1 replay. An item this file does not know reads a missing variable: the render fails. #}
{% macro departure_item(key, r_year, lags) %}{% if key == 'A3' %}A misplaced value is moved back only when its destination is unambiguous: the next-best destination must cost at least the minimum ratio times the chosen one (data-quality report, section 3.2).{% elif key == 'A4' %}A duplicated value outside the physical bounds can take part in no repair, and no hour whose value lies outside those bounds is returned as usable.{% elif key == 'B1' %}Design code (validation folds, thresholds, frozen models) sees each decision time as the replay sees its clock, and an interval's half-width is calibrated only on the days already scored when its model is fitted.{% elif key == 'B2' %}The lookahead guard loses its {{ lags[1] }}-hour term, which could never fire on its own.{% elif key == 'B3' %}The thresholds are calibrated on the weeks the replay judges: a week holding a day that fails data quality, or whose days are not all in the period, no longer enters them.{% elif key == 'B4' %}The freeze gate runs inside the replay itself, so no entry point replays {{ r_year }} without it.{% elif key == 'B5' %}The moved-tag check also reads the repository's replay ledger (`docs/replay-ledger.json`), so a fresh clone of the repository sees a departure.{% elif key == 'B6' %}The rules' false alarms and blind spots are also measured on {{ r_year }}.{% else %}{{ unknown_departure_item }}{% endif %}{% endmacro %}
{# The alarms of one-day shocks, per year (report/validation.py::episode_limits, `one_day`). The clean share is
   measured for "retrain" only. #}
{% macro one_day_alarms(items) %}{% if not items %}{{ unread_one_day_years }}{% endif %}**Alarms from one-day shocks**: {% for year, O in items %}on {{ year }}, {{ O.retrain|num }} "retrain" ({{ O.retrain_clean|num }} of them clean) and {{ O.recalibrate|num }} "recalibrate", out of {{ O.cases|num }} cases (starts × factors){% if not loop.last %}; {% endif %}{% endfor %}. One bad day can give one only by completing failing days the weeks already held, which the trim had been setting aside; the clean share is measured for "retrain" only, and the weeks involved are in the run.{% endmacro %}
{# A replay a departure departs from (report/validation.py::departure): finished, shown from the store or the ledger;
   a start that did not finish, shown as such; or, named by a replay shown from the ledger, kept only in the store of
   the machine that ran it. #}
{% macro predecessor(d, say) %}{% if d.absent %}the start `{{ d.id }}`, which never finished: it is in no ledger, and only the run store of the machine that ran it keeps it{% elif d.unfinished %}the start `{{ d.id }}` (rules of commit `{{ d.freeze_commit|short }}`), which {{ say.unfinished }}: stopped at "{{ STAGE[d.stage] }}"{% if d.error %}, error `{{ d.error }}`{% endif %}; it is not a result{% else %}the replay `{{ d.id }}` (rules of commit `{{ d.freeze_commit|short }}`, MAPE {{ d.summary.mape.mean|pct(2) }}, coverage {{ d.summary.coverage.mean|pct(1) }}){% if d.recorded %}, {{ say.ledger_label|lower|replace('.', '') }}{% endif %}{% endif %}{% endmacro %}
{# The model card's limits beside a replayed year's recommendations (report/validation.py::detection_limits): what that
   year's power tables show the rules can miss, so that silence is not read as a clean result. #}
{% macro card_limits(L, horizon) %}a sustained gap of ±{{ L.smallest|pct(0) }} between demand and forecast yielded "retrain" within {{ horizon }} weeks at {{ L.smallest_by_sign.up.caught + L.smallest_by_sign.down.caught }} of {{ L.smallest_by_sign.up.cases + L.smallest_by_sign.down.cases }} cases, and intervals cut to × {{ L.strongest|num(1) }} of their half-width yielded "recalibrate" at {{ L.strongest_caught.caught }} of {{ L.strongest_caught.cases }} starts{% if L.milder_max == 0 %}, and no milder cut did{% elif L.milder_max is not none %}, and milder cuts at {{ L.milder_max }} of {{ L.half_width_starts }} at most{% endif %}{% endmacro %}
{# A replayed year's weekly coverage against the nominal, by season (report/validation.py::weekly_coverage): no interval
   is computed on it. #}
{% macro weekly_cov(WC, nominal, year) %}By judged week of {{ year }}, coverage fell below the {{ nominal|pct(0) }} nominal in {{ WC.below }} of {{ WC.judged }} weeks: {% for s, x in WC.seasons.items() %}{{ THE_SEASON[s] }}, {{ x.below }} of {{ x.judged }}{% if not loop.last %}; {% endif %}{% endfor %}{% endmacro %}
