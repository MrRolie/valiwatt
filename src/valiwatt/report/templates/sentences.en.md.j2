{# The validation report's sentences that depend on the results: each branch says only what its data show. The
   computations are in report/validation.py (derive); tests/test_report_sentences.py walks the branches. #}
{% set pct_sign = '%' %}
{% macro sp(x, d=1) %}{{ (100 * x)|signed(d) }}{{ pct_sign }}{% endmacro %}
{% set MONTH = {1: 'January', 2: 'February', 3: 'March', 4: 'April', 5: 'May', 6: 'June', 7: 'July', 8: 'August', 9: 'September', 10: 'October', 11: 'November', 12: 'December'} %}
{% set THE_SEASON = {'winter': 'winter', 'spring': 'spring', 'summer': 'summer', 'fall': 'fall'} %}
{% set FAIL = {'mape_high': 'MAPE', 'bias_high': 'the bias, high side', 'bias_low': 'the bias, low side'} %}
{% macro and_list(items) %}{% for x in items %}{{ x }}{% if loop.revindex == 2 %} and {% elif not loop.last %}, {% endif %}{% endfor %}{% endmacro %}
{% macro months(ms) %}{% set names = [] %}{% for m in ms %}{% set _ = names.append(MONTH[m]) %}{% endfor %}{{ and_list(names) }}{% endmacro %}
{% macro groups(seasons, deciles) %}{% set parts = [] %}{% set names = [] %}{% for s in seasons %}{% set _ = names.append(THE_SEASON[s]) %}{% endfor %}{% if seasons %}{% set _ = parts.append(and_list(names)) %}{% endif %}{% if deciles %}{% set _ = parts.append(('forecast-load decile ' if deciles|length == 1 else 'forecast-load deciles ') ~ and_list(deciles)) %}{% endif %}{{ parts|join('; ') }}{% endmacro %}
{# Under- and over-coverage, on the 95% CIs as printed (report/validation.py::coverage_sides). #}
{% macro coverage_sides(season, decile, nominal) %}{% if season.under or decile.under %}Under-covered, their 95% CI wholly below the {{ nominal|pct(0) }} nominal: {{ groups(season.under, decile.under) }}.{% else %}No season and no load decile has its 95% CI wholly below the {{ nominal|pct(0) }} nominal.{% endif %} {% if season.over or decile.over %}Over-covered, the CI wholly above: {{ groups(season.over, decile.over) }}.{% else %}No group has its CI wholly above.{% endif %}{% endmacro %}
{# What a replay's power table shows (report/validation.py::detection_limits). #}
{% macro power_limit(L, year, horizon) %}{% if L.every_from is not none %}On {{ year }}, a sustained gap of ±{{ L.every_from|pct(0) }} or more between demand and forecast yielded "retrain" within {{ horizon }} weeks at each of the {{ L.starts }} starts{% else %}On {{ year }}, no size of gap measured between demand and forecast yielded "retrain" at each of the {{ L.starts }} starts within {{ horizon }} weeks{% endif %}; a gap of +{{ L.smallest|pct(0) }} did at {{ L.smallest_by_sign.up.caught }} of {{ L.smallest_by_sign.up.cases }} starts, and of −{{ L.smallest|pct(0) }} at {{ L.smallest_by_sign.down.caught }} of {{ L.smallest_by_sign.down.cases }}. Intervals cut to × {{ L.strongest|num(1) }} of their half-width yielded "recalibrate" at {{ L.strongest_caught.caught }} of {{ L.strongest_caught.cases }} starts{% if L.milder_max == 0 %}; no milder cut (up to × {{ L.mildest|num(1) }}) did{% elif L.milder_max is not none %}; milder cuts (up to × {{ L.mildest|num(1) }}) at most at {{ L.milder_max }} of {{ L.half_width_starts }} starts{% endif %}.{% endmacro %}
{# One week, as the monitor judges it. #}
{% macro week_ev(w) %}MAPE {{ w.stats.mape|pct(2) }}{% if w.flags.mape_high %} above its threshold{% endif %}, bias {{ sp(w.stats.rel_bias, 2) }}{% if w.flags.bias_high or w.flags.bias_low %} outside its band{% endif %}{% endmacro %}
{% macro stat(failure, x) %}{% if failure == 'mape_high' %}{{ x|pct(2) }}{% else %}{{ sp(x, 2) }}{% endif %}{% endmacro %}
{# The weeks where the first wording of rule 2 says "retrain", then why the rule kept did or did not
   (report/validation.py::near_misses). #}
{% macro near_list(items) %}{% for d in items %}in the week of {{ d.week_start|day }} (the week before: {{ week_ev(d.weeks[0]) }}; that week: {{ week_ev(d.weeks[1]) }}){% if not loop.last %}, then {% endif %}{% endfor %}{% endmacro %}
{% macro near_why(items, trim_days) %}{% for d in items %}{% if not loop.first %} {% endif %}Week of {{ d.week_start|day }}: {% if d.kept_by == 'fired' %}the rule kept said "retrain" too.{% elif d.kept_by == 'different' %}the two weeks do not show the same failure, and the rule kept sees nothing.{% elif d.kept_by == 'echo' %}MAPE is above its threshold, broad, in both weeks, but the bias leaves its band on one side and then the other: the rule kept sets it aside as an echo.{% else %}{% for s in d.same %}{{ FAIL[s.failure] }} is beyond its threshold in both weeks, but without each week's {{ trim_days }} most extreme days it is {{ stat(s.failure, s.trimmed[0]) }} then {{ stat(s.failure, s.trimmed[1]) }}{% if s.thresholds_equal %} against a threshold of {{ stat(s.failure, s.threshold) }}{% endif %}: {% if s.broad|select|list|length == 0 %}neither week is broadly beyond it{% else %}one of the two weeks is not broadly beyond it{% endif %}{% if not loop.last %}; {% endif %}{% endfor %}; so the rule kept sees nothing.{% if d.bias_flips and not d.bias_flagged %} The bias changes sign from one week to the next, but stays inside its band in both weeks: the echo exclusion is not what applies.{% endif %}{% endif %}{% endfor %}{% endmacro %}
{% macro pp(x, d=2) %}{{ (100 * x)|signed(d) }} pt{% endmacro %}
{% macro ppci(lo, hi, d=2) %}[{{ pp(lo, d) }}, {{ pp(hi, d) }}]{% endmacro %}
{% macro span(years) %}{{ years[0] }}–{{ years[1] }}{% endmacro %}
{% macro recs(n) %}{% if n == 0 %}no recommendation{% elif n == 1 %}1 recommendation{% else %}{{ n }} recommendations{% endif %}{% endmacro %}
{# The spring 2020 interval of the difference, added after the results, with the Monte Carlo error of its bounds
   (report/validation.py::shift_difference, shift_verdict). #}
{% set BOUND = {'low': 'lower', 'high': 'upper'} %}
{% macro mc_se(x) %}{{ (100 * x)|num(3) }} pt{% endmacro %}
{% macro diff_verdict(d) %}{% if d.verdict == 'undetermined' %}undetermined at this resolution: the {{ BOUND[d.near.bound] }} bound, {{ pp(d.near.value, 3) }}, {% if d.near.by == 'mc' %}lies within {{ d.mc_multiple }} Monte Carlo standard errors ({{ mc_se(d.near.se) }}) of zero{% else %}rounds to zero at a hundredth of a point{% endif %}, and section 1's rule does not decide{% elif d.verdict == 'confirmed' %}under section 1's rule, the gap is confirmed{% else %}under section 1's rule, the gap is not confirmed{% endif %} ({{ d.draws|num }} draws per side, in {{ d.batches }} independent batches of {{ d.batch_draws|num }}; Monte Carlo standard error of the bounds, measured by their spread from one batch to the next: {{ mc_se(d.mc_se_low) }} and {{ mc_se(d.mc_se_high) }}{% if d.verdict != 'undetermined' %}, each bound more than {{ d.mc_multiple }} of its standard errors from zero{% endif %}){% endmacro %}
{% macro spring_card(sh, d) %}{% if sh.separated %}a gap confirmed by disjoint intervals{% else %}a gap not confirmed by disjoint intervals{% endif %}; the interval of the difference, added after the results, {% if d.verdict == 'confirmed' %}confirms the gap{% elif d.verdict == 'not_confirmed' %}does not confirm the gap{% elif d.near.by == 'mc' %}does not decide at this resolution: a bound lies within {{ d.mc_multiple }} Monte Carlo standard errors of zero{% else %}does not decide at this resolution: a bound rounds to zero{% endif %}{% endmacro %}
{# The validation report's "In brief", one bullet per macro. #}
{% macro brief_error(P, c1, vy) %}Over {{ span(vy) }}, the forecast is off by {{ P.persistence.overall.mean|pct(2) }} of hourly demand on average, against {{ P.baseline.overall.mean|pct(2) }} for a naive forecast (the same hour one week earlier){% if c1.separated and c1.difference < 0 %}: it does better, and the gap is confirmed{% elif c1.separated %}: it does worse, and the gap is confirmed{% else %}; the gap is not confirmed{% endif %}.{% endmacro %}
{% macro brief_coverage(nominal, overall, first_fold, sides) %}Its {{ nominal|pct(0) }} intervals held demand {{ overall|pct(1) }} of the time from {{ first_fold }} on{% if sides.overall.under %}, less than nominal, 95% CI included{% elif sides.overall.over %}, more than nominal, 95% CI included{% else %}, and the 95% CI of that coverage contains the nominal{% endif %}. {% if sides.season.under or sides.decile.under %}They hold it less often than promised in these groups: {{ groups(sides.season.under, sides.decile.under) }} (section 4).{% else %}No season and no load decile is under-covered in the sense of section 4.{% endif %}{% endmacro %}
{% macro brief_peak(peak, years, in_month, above) %}At the {{ peak.hours|length }} busiest hours of {{ span(years) }}{% if in_month %}, all in {{ peak.named_month }}{% endif %}, {% if peak.evaluated == 0 %}no prediction interval is computed{% elif peak.covered == peak.evaluated %}demand stayed inside the interval every time ({{ peak.evaluated }} hours judged){% else %}demand fell outside the interval {{ peak.evaluated - peak.covered }} times out of {{ peak.evaluated }}{% if above == peak.evaluated - peak.covered %}, always above it{% endif %}{% endif %}.{% endmacro %}
{% macro brief_replay(r, n_recs, departures) %}Replayed as production, with the model and the rules frozen, {{ r.year }} {% if n_recs == 0 %}triggered no recommendation{% else %}triggered {{ recs(n_recs) }}{% endif %} (MAPE {{ r.summary.mape.mean|pct(2) }}, coverage {{ r.summary.coverage.mean|pct(1) }}){% if departures %}, **post hoc**, after a departure from the frozen rules{% endif %}.{% endmacro %}
{% macro brief_misses(level, L, p_year, r_year, horizon) %}The report also measures what the monitor could miss: on {{ p_year }}, a sustained {{ level.size|pct(0) }} rise in demand yielded "retrain" within {{ horizon }} weeks at {{ level.up_n - level.up_missed }} of {{ level.up_n }} starts; on {{ r_year }}, a sustained gap of ±{{ L.smallest|pct(0) }} between demand and forecast did at {{ L.smallest_by_sign.up.caught + L.smallest_by_sign.down.caught }} of {{ L.smallest_by_sign.up.cases + L.smallest_by_sign.down.cases }} cases (sections 6 to 8).{% endmacro %}
{# Section 9: a break's result word, and the synthetic world's level shift set against section 8. #}
{% macro break_result(row) %}{% if row.outcome != 'passed' %}FAILED{% elif row.control %}stayed quiet{% else %}fired{% endif %}{% endmacro %}
{% macro level_shift_note(label, world, level, p_year, horizon) %}The break "{{ label }}" multiplies the synthetic world's demand by {{ (1 + world.level_shift)|num(2) }}, a {{ world.level_shift|pct(0) }} rise. {% if level.up_missed %}On the real {{ p_year }} hours, a {{ level.size|pct(0) }} rise did not yield "retrain" within {{ horizon }} weeks at {{ level.up_missed }} of {{ level.up_n }} starts (section 8): the rule can fire, but it did not see such a rise in real demand {% if level.up_missed == level.up_n %}at any start{% else %}at every start{% endif %}.{% else %}On the real {{ p_year }} hours, a {{ level.size|pct(0) }} rise yielded "retrain" within {{ horizon }} weeks at every start (section 8).{% endif %}{% endmacro %}
