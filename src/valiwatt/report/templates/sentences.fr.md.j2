{# Les phrases du rapport de validation qui dépendent des résultats : chaque branche dit seulement ce que ses données
   montrent. Les calculs sont dans report/validation.py (derive) ; tests/test_report_sentences.py parcourt les
   branches. #}
{% set pct_sign = ' %' %}
{% macro sp(x, d=1) %}{{ (100 * x)|signed(d) }}{{ pct_sign }}{% endmacro %}
{% set MONTH = {1: 'janvier', 2: 'février', 3: 'mars', 4: 'avril', 5: 'mai', 6: 'juin', 7: 'juillet', 8: 'août', 9: 'septembre', 10: 'octobre', 11: 'novembre', 12: 'décembre'} %}
{% set THE_SEASON = {'winter': "l'hiver", 'spring': 'le printemps', 'summer': "l'été", 'fall': "l'automne"} %}
{% set FAIL = {'mape_high': "l'EAMP", 'bias_high': 'le biais, côté haut', 'bias_low': 'le biais, côté bas'} %}
{% macro and_list(items) %}{% for x in items %}{{ x }}{% if loop.revindex == 2 %} et {% elif not loop.last %}, {% endif %}{% endfor %}{% endmacro %}
{% macro months(ms) %}{% set names = [] %}{% for m in ms %}{% set _ = names.append(MONTH[m]) %}{% endfor %}{{ and_list(names) }}{% endmacro %}
{% macro groups(seasons, deciles) %}{% set parts = [] %}{% set names = [] %}{% for s in seasons %}{% set _ = names.append(THE_SEASON[s]) %}{% endfor %}{% if seasons %}{% set _ = parts.append(and_list(names)) %}{% endif %}{% if deciles %}{% set _ = parts.append(('le décile de charge prévue ' if deciles|length == 1 else 'les déciles de charge prévue ') ~ and_list(deciles)) %}{% endif %}{{ parts|join(' ; ') }}{% endmacro %}
{# Sous- et sur-couverture, sur les IC 95 % tels qu'imprimés (report/validation.py::coverage_sides). #}
{% macro coverage_sides(season, decile, nominal) %}{% if season.under or decile.under %}Sous-couverts, leur IC 95 % entièrement sous le nominal de {{ nominal|pct(0) }} : {{ groups(season.under, decile.under) }}.{% else %}Aucune saison ni aucun décile de charge n'a son IC 95 % entièrement sous le nominal de {{ nominal|pct(0) }}.{% endif %} {% if season.over or decile.over %}Sur-couverts, l'IC entièrement au-dessus : {{ groups(season.over, decile.over) }}.{% else %}Aucun groupe n'a son IC entièrement au-dessus.{% endif %}{% endmacro %}
{# Ce que le tableau de puissance d'un rejeu montre (report/validation.py::detection_limits). #}
{% macro power_limit(L, year, horizon) %}{% if L.every_from is not none %}Sur {{ year }}, un écart soutenu de ±{{ L.every_from|pct(0) }} ou plus entre la demande et la prévision a donné « réentraîner » en {{ horizon }} semaines au plus à chacun des {{ L.starts }} départs{% else %}Sur {{ year }}, aucune taille d'écart mesurée entre la demande et la prévision n'a donné « réentraîner » à chacun des {{ L.starts }} départs en {{ horizon }} semaines{% endif %} ; un écart de +{{ L.smallest|pct(0) }}, à {{ L.smallest_by_sign.up.caught }} des {{ L.smallest_by_sign.up.cases }} départs, et de −{{ L.smallest|pct(0) }}, à {{ L.smallest_by_sign.down.caught }} des {{ L.smallest_by_sign.down.cases }}. Des intervalles réduits à × {{ L.strongest|num(1) }} de leur demi-largeur ont donné « recalibrer » à {{ L.strongest_caught.caught }} des {{ L.strongest_caught.cases }} départs{% if L.milder_max == 0 %} ; aucune réduction moindre (jusqu'à × {{ L.mildest|num(1) }}) ne l'a donné{% elif L.milder_max is not none %} ; des réductions moindres (jusqu'à × {{ L.mildest|num(1) }}), à {{ L.milder_max }} des {{ L.half_width_starts }} départs au plus{% endif %}.{% endmacro %}
{# Une semaine, comme le moniteur la juge. #}
{% macro week_ev(w) %}EAMP {{ w.stats.mape|pct(2) }}{% if w.flags.mape_high %} hors seuil{% endif %}, biais {{ sp(w.stats.rel_bias, 2) }}{% if w.flags.bias_high or w.flags.bias_low %} hors bande{% endif %}{% endmacro %}
{% macro stat(failure, x) %}{% if failure == 'mape_high' %}{{ x|pct(2) }}{% else %}{{ sp(x, 2) }}{% endif %}{% endmacro %}
{# Les semaines où la première formulation de la règle 2 dit « réentraîner », puis pourquoi la règle retenue l'a dit
   ou non (report/validation.py::near_misses). #}
{% macro near_list(items) %}{% for d in items %}la semaine du {{ d.week_start|day }} (la semaine d'avant : {{ week_ev(d.weeks[0]) }} ; celle-ci : {{ week_ev(d.weeks[1]) }}){% if not loop.last %}, puis {% endif %}{% endfor %}{% endmacro %}
{% macro near_why(items, trim_days) %}{% for d in items %}{% if not loop.first %} {% endif %}Semaine du {{ d.week_start|day }} : {% if d.kept_by == 'fired' %}la règle retenue a dit « réentraîner » elle aussi.{% elif d.kept_by == 'different' %}les deux semaines ne montrent pas la même défaillance, et la règle retenue n'y voit rien.{% elif d.kept_by == 'echo' %}l'EAMP est hors seuil, étendue, les deux semaines, mais le biais sort de sa bande d'un côté puis de l'autre : la règle retenue l'écarte comme un écho.{% else %}{% for s in d.same %}{{ FAIL[s.failure] }} est au-delà de son seuil les deux semaines, mais, sans les {{ trim_days }} jours les plus extrêmes de chaque semaine, vaut {{ stat(s.failure, s.trimmed[0]) }} puis {{ stat(s.failure, s.trimmed[1]) }}{% if s.thresholds_equal %} pour un seuil de {{ stat(s.failure, s.threshold) }}{% endif %} : {% if s.broad|select|list|length == 0 %}aucune des deux semaines n'est hors seuil, étendue{% else %}l'une des deux semaines n'est pas hors seuil, étendue{% endif %}{% if not loop.last %} ; {% endif %}{% endfor %} ; la règle retenue n'y voit donc rien.{% if d.bias_flips and not d.bias_flagged %} Le biais change de signe d'une semaine à l'autre, mais reste dans sa bande les deux semaines : ce n'est pas l'exclusion de l'écho qui joue.{% endif %}{% endif %}{% endfor %}{% endmacro %}
