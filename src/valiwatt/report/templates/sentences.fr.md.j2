{# Les phrases du rapport de validation qui dépendent des résultats : chaque branche dit seulement ce que ses données
   montrent. Les calculs sont dans report/validation.py (derive) ; tests/test_report_sentences.py parcourt les
   branches. #}
{% set pct_sign = ' %' %}
{% macro sp(x, d=1) %}{{ (100 * x)|signed(d) }}{{ pct_sign }}{% endmacro %}
{% set MONTH = {1: 'janvier', 2: 'février', 3: 'mars', 4: 'avril', 5: 'mai', 6: 'juin', 7: 'juillet', 8: 'août', 9: 'septembre', 10: 'octobre', 11: 'novembre', 12: 'décembre'} %}
{% set THE_SEASON = {'winter': "l'hiver", 'spring': 'le printemps', 'summer': "l'été", 'fall': "l'automne"} %}
{% set FAIL = {'mape_high': "l'EAMP", 'bias_high': 'le biais, côté haut', 'bias_low': 'le biais, côté bas'} %}
{% macro and_list(items) %}{% for x in items %}{{ x }}{% if loop.revindex == 2 %} et {% elif not loop.last %}, {% endif %}{% endfor %}{% endmacro %}
{% macro months(ms) %}{% set names = [] %}{% for m in ms %}{% set _ = names.append(MONTH[m]) %}{% endfor %}{{ and_list(names) }}{% endmacro %}
{% macro groups(seasons, deciles) %}{% set parts = [] %}{% set names = [] %}{% for s in seasons %}{% set _ = names.append(THE_SEASON[s]) %}{% endfor %}{% if seasons %}{% set _ = parts.append(and_list(names)) %}{% endif %}{% if deciles %}{% set _ = parts.append(('le décile de charge prévue ' if deciles|length == 1 else 'les déciles de charge prévue ') ~ and_list(deciles)) %}{% endif %}{{ parts|join(' ; ') }}{% endmacro %}
{# Sous- et sur-couverture, sur les IC 95 % tels qu'imprimés (report/validation.py::coverage_sides). #}
{% macro coverage_sides(season, decile, nominal) %}{% if season.under or decile.under %}Sous-couverts, leur IC 95 % entièrement sous le nominal de {{ nominal|pct(0) }} : {{ groups(season.under, decile.under) }}.{% else %}Aucune saison ni aucun décile de charge n'a son IC 95 % entièrement sous le nominal de {{ nominal|pct(0) }}.{% endif %} {% if season.over or decile.over %}Sur-couverts, l'IC entièrement au-dessus : {{ groups(season.over, decile.over) }}.{% else %}Aucun groupe n'a son IC entièrement au-dessus.{% endif %}{% endmacro %}
{# Ce que le tableau de puissance d'un rejeu montre (report/validation.py::detection_limits). #}
{% macro power_limit(L, year, horizon) %}{% if L.every_from is not none %}Sur {{ year }}, un écart soutenu de ±{{ L.every_from|pct(0) }} ou plus entre la demande et la prévision a donné « réentraîner » en {{ horizon }} semaines au plus à chacun des {{ L.starts }} départs{% else %}Sur {{ year }}, aucune taille d'écart mesurée entre la demande et la prévision n'a donné « réentraîner » à chacun des {{ L.starts }} départs en {{ horizon }} semaines{% endif %} ; un écart de +{{ L.smallest|pct(0) }}, à {{ L.smallest_by_sign.up.caught }} des {{ L.smallest_by_sign.up.cases }} départs, et de −{{ L.smallest|pct(0) }}, à {{ L.smallest_by_sign.down.caught }} des {{ L.smallest_by_sign.down.cases }}. Sur {{ year }}, des intervalles réduits à × {{ L.strongest|num(1) }} de leur demi-largeur ont donné « recalibrer » à {{ L.strongest_caught.caught }} des {{ L.strongest_caught.cases }} départs{% if L.milder_max == 0 %} ; aucune réduction moindre (jusqu'à × {{ L.mildest|num(1) }}) ne l'a donné{% elif L.milder_max is not none %} ; des réductions moindres (jusqu'à × {{ L.mildest|num(1) }}), à {{ L.milder_max }} des {{ L.half_width_starts }} départs au plus{% endif %}.{% endmacro %}
{# Une semaine, comme le moniteur la juge. #}
{% macro week_ev(w) %}EAMP {{ w.stats.mape|pct(2) }}{% if w.flags.mape_high %} hors seuil{% endif %}, biais {{ sp(w.stats.rel_bias, 2) }}{% if w.flags.bias_high or w.flags.bias_low %} hors bande{% endif %}{% endmacro %}
{% macro stat(failure, x) %}{% if failure == 'mape_high' %}{{ x|pct(2) }}{% else %}{{ sp(x, 2) }}{% endif %}{% endmacro %}
{# Les semaines où la première formulation de la règle 2 dit « réentraîner », puis pourquoi la règle retenue l'a dit
   ou non (report/validation.py::near_misses). #}
{% macro near_list(items) %}{% for d in items %}la semaine du {{ d.week_start|day }} (la semaine d'avant : {{ week_ev(d.weeks[0]) }} ; celle-ci : {{ week_ev(d.weeks[1]) }}){% if not loop.last %}, puis {% endif %}{% endfor %}{% endmacro %}
{% macro near_why(items, trim_days) %}{% for d in items %}{% if not loop.first %} {% endif %}Semaine du {{ d.week_start|day }} : {% if d.kept_by == 'fired' %}la règle retenue a dit « réentraîner » elle aussi.{% elif d.kept_by == 'different' %}les deux semaines ne montrent pas la même défaillance, et la règle retenue n'y voit rien.{% elif d.kept_by == 'echo' %}l'EAMP est hors seuil, étendue, les deux semaines, mais le biais sort de sa bande d'un côté puis de l'autre : la règle retenue l'écarte comme un écho.{% else %}{% for s in d.same %}{{ FAIL[s.failure] }} est au-delà de son seuil les deux semaines, mais, sans les {{ trim_days }} jours les plus extrêmes de chaque semaine, vaut {{ stat(s.failure, s.trimmed[0]) }} puis {{ stat(s.failure, s.trimmed[1]) }}{% if s.thresholds_equal %} pour un seuil de {{ stat(s.failure, s.threshold) }}{% endif %} : {% if s.broad|select|list|length == 0 %}aucune des deux semaines n'est hors seuil, étendue{% else %}l'une des deux semaines n'est pas hors seuil, étendue{% endif %}{% if not loop.last %} ; {% endif %}{% endfor %} ; la règle retenue n'y voit donc rien.{% if d.bias_flips and not d.bias_flagged %} Le biais change de signe d'une semaine à l'autre, mais reste dans sa bande les deux semaines : ce n'est pas l'exclusion de l'écho qui joue.{% endif %}{% endif %}{% endfor %}{% endmacro %}
{% macro pp(x, d=2) %}{{ (100 * x)|signed(d) }} pt{% endmacro %}
{% macro ppci(lo, hi, d=2) %}[{{ pp(lo, d) }} ; {{ pp(hi, d) }}]{% endmacro %}
{% macro span(years) %}{{ years[0] }}–{{ years[1] }}{% endmacro %}
{% macro recs(n) %}{% if n == 0 %}aucune recommandation{% elif n == 1 %}1 recommandation{% else %}{{ n }} recommandations{% endif %}{% endmacro %}
{# L'intervalle de la différence du printemps 2020, ajouté après les résultats, avec l'erreur de Monte-Carlo de ses
   bornes (report/validation.py::shift_difference, shift_verdict). #}
{% set BOUND = {'low': 'inférieure', 'high': 'supérieure'} %}
{% macro mc_se(x, d) %}{{ (100 * x)|num(d) }} pt{% endmacro %}
{% macro diff_verdict(d) %}{% if d.verdict == 'undetermined' %}indéterminé à cette résolution : la borne {{ BOUND[d.near.bound] }}{% if d.near.by == 'mc' %}, {{ pp(d.near.value, d.digits) }}, n'est pas à plus de {{ d.mc_multiple }} erreurs types de Monte-Carlo ({{ mc_se(d.near.se, d.digits) }}) de zéro{% else %} s'arrondit à zéro au centième de point près{% endif %}, et la règle de la section 1 ne tranche pas{% elif d.verdict == 'confirmed' %}selon la règle de la section 1, l'écart est confirmé{% else %}selon la règle de la section 1, l'écart n'est pas confirmé{% endif %} ({{ d.draws|num }} tirages par côté, en {{ d.batches }} lots indépendants de {{ d.batch_draws|num }} ; erreur type de Monte-Carlo des bornes, mesurée par leur dispersion d'un lot à l'autre : {{ mc_se(d.mc_se_low, d.digits) }} et {{ mc_se(d.mc_se_high, d.digits) }}{% if d.verdict != 'undetermined' %} ; bornes à cette précision : {{ pp(d.ci95_low, d.digits) }} et {{ pp(d.ci95_high, d.digits) }}, chacune à plus de {{ d.mc_multiple }} de ses erreurs types de zéro{% endif %}){% endmacro %}
{% macro spring_card(sh, d) %}{% if sh.separated %}écart confirmé par des intervalles disjoints{% else %}écart non confirmé par des intervalles disjoints{% endif %} ; l'intervalle de la différence, ajouté après les résultats, {% if d.verdict == 'confirmed' %}confirme l'écart{% elif d.verdict == 'not_confirmed' %}ne confirme pas l'écart{% elif d.near.by == 'mc' %}ne tranche pas à cette résolution : une borne n'est pas à plus de {{ d.mc_multiple }} erreurs types de Monte-Carlo de zéro{% else %}ne tranche pas à cette résolution : une borne s'arrondit à zéro{% endif %}{% endmacro %}
{# L'en-bref du rapport de validation, une puce par macro. #}
{% macro brief_error(P, c1, vy) %}Sur {{ span(vy) }}, la prévision s'écarte en moyenne de {{ P.persistence.overall.mean|pct(2) }} de la demande horaire, contre {{ P.baseline.overall.mean|pct(2) }} pour une prévision naïve (la même heure, une semaine avant){% if c1.separated and c1.difference < 0 %} : elle fait mieux, et l'écart est confirmé{% elif c1.separated %} : elle fait moins bien, et l'écart est confirmé{% else %} ; l'écart n'est pas confirmé{% endif %}.{% endmacro %}
{% macro brief_coverage(nominal, overall, first_fold, sides) %}Ses intervalles à {{ nominal|pct(0) }} ont contenu la demande {{ overall|pct(1) }} du temps depuis {{ first_fold }}{% if sides.overall.under %}, moins que le nominal, IC 95 % compris{% elif sides.overall.over %}, plus que le nominal, IC 95 % compris{% else %}, et l'IC 95 % de cette couverture contient le nominal{% endif %}. {% if sides.season.under or sides.decile.under %}Ils en contiennent moins que promis dans ces groupes : {{ groups(sides.season.under, sides.decile.under) }} (section 4).{% else %}Aucune saison ni aucun décile de charge n'est sous-couvert au sens de la section 4.{% endif %}{% endmacro %}
{% macro brief_peak(peak, years, in_month, above) %}Aux {{ peak.hours|length }} heures les plus chargées de {{ span(years) }}{% if in_month %}, toutes en {{ peak.named_month }}{% endif %}, {% if peak.evaluated == 0 %}aucun intervalle de prévision n'est calculé{% elif peak.covered == peak.evaluated %}la demande est restée dans l'intervalle chaque fois ({{ peak.evaluated }} heures jugées){% else %}la demande est sortie de l'intervalle {{ peak.evaluated - peak.covered }} fois sur {{ peak.evaluated }}{% if above == peak.evaluated - peak.covered %}, toujours par le haut{% endif %}{% endif %}.{% endmacro %}
{% macro brief_replay(r, n_recs, departures) %}Rejouée comme en production, avec le modèle et les règles gelés, l'année {{ r.year }} {% if n_recs == 0 %}n'a déclenché aucune recommandation{% else %}a déclenché {{ recs(n_recs) }}{% endif %} (EAMP {{ r.summary.mape.mean|pct(2) }}, couverture {{ r.summary.coverage.mean|pct(1) }}){% if departures %}, **a posteriori**, après une dérogation aux règles gelées{% endif %}.{% endmacro %}
{% macro brief_misses(level, L, p_year, r_year, horizon, level24=none) %}Le rapport mesure aussi ce que le moniteur pouvait manquer : sur {{ p_year }}, une hausse soutenue de {{ level.size|pct(0) }} de la demande a donné « réentraîner » en {{ horizon }} semaines à {{ level.up_n - level.up_missed }} des {{ level.up_n }} départs{% if level24 %}, et sur {{ r_year }}, hors échantillon, à {{ level24.up_n - level24.up_missed }} des {{ level24.up_n }}{% endif %} ; sur {{ r_year }}, un écart soutenu de ±{{ L.smallest|pct(0) }} entre la demande et la prévision, à {{ L.smallest_by_sign.up.caught + L.smallest_by_sign.down.caught }} des {{ L.smallest_by_sign.up.cases + L.smallest_by_sign.down.cases }} cas (sections 6 à 8).{% endmacro %}
{# Section 9 : le mot du résultat d'un bris, et le changement de niveau du monde synthétique face à la section 8. #}
{% macro break_result(row) %}{% if row.outcome != 'passed' %}ÉCHEC{% elif row.control %}resté silencieux{% else %}déclenché{% endif %}{% endmacro %}
{% macro level_shift_note(label, world, level, p_year, horizon) %}Le bris « {{ label }} » multiplie la demande du monde synthétique par {{ (1 + world.level_shift)|num(2) }}, une hausse de {{ world.level_shift|pct(0) }}. {% if level.up_missed %}Sur les vraies heures de {{ p_year }}, une hausse de {{ level.size|pct(0) }} n'a pas donné « réentraîner » en {{ horizon }} semaines à {{ level.up_missed }} des {{ level.up_n }} départs (section 8) : la règle peut se déclencher, mais {% if level.up_missed == level.up_n %}elle n'a vu une telle hausse dans la vraie demande à aucun départ{% else %}elle n'a pas vu une telle hausse dans la vraie demande à chaque départ{% endif %}.{% else %}Sur les vraies heures de {{ p_year }}, une hausse de {{ level.size|pct(0) }} a donné « réentraîner » en {{ horizon }} semaines à chaque départ (section 8).{% endif %}{% endmacro %}
{% macro level_shift_note_replay(level, r_year, horizon) %}Sur les vraies heures de {{ r_year }}, hors échantillon, {% if level.up_missed %}la même hausse n'a pas donné « réentraîner » en {{ horizon }} semaines à {{ level.up_missed }} des {{ level.up_n }} départs{% else %}la même hausse a donné « réentraîner » en {{ horizon }} semaines à chaque départ{% endif %} (section 8).{% endmacro %}
{# Section 5 : les semaines écartées des seuils, décomptées par l'exécution de validation. Singulier pour 0 et 1. #}
{% macro set_aside(nx24, nx23, years24, years23, p_year) %}Pour ces raisons, {{ nx24 }} semaine{{ 's' if nx24 > 1 }} de {{ span(years24) }} {{ 'ont' if nx24 > 1 else 'a' }} été écartée{{ 's' if nx24 > 1 }} ({{ nx23 }} de {{ span(years23) }} pour le rejeu de {{ p_year }}){% if nx24 or nx23 %} ; l'exécution de validation consigne chacune avec sa raison{% endif %}.{% endmacro %}
{# Section 8 : les fausses alertes et les angles morts mesurés sur une année (report/validation.py::episode_limits,
   level_shift). #}
{% macro episode_limit(E, year, mild) %}sur {{ year }}, {% if E.worst %}jusqu'à {{ E.share|pct(1) }} des départs pour {{ E.worst.days }} jours à × {{ E.worst.factor|num(2) }}, et au plus {{ E.mild|pct(1) }} pour un épisode de ±{{ mild|pct(0) }}{% else %}aucun épisode de plusieurs jours n'a donné « réentraîner »{% endif %}{% endmacro %}
{% macro level_limit(level, year, horizon) %}Sur {{ year }}, {% if level.up_missed %}une hausse soutenue de {{ level.size|pct(0) }} de la demande n'a pas donné « réentraîner » en {{ horizon }} semaines à {{ level.up_missed }} départ{{ 's' if level.up_missed > 1 }} sur {{ level.up_n }} ({{ months(level.months) }}), et une baisse de {{ level.size|pct(0) }} l'a donné à {{ level.down_caught }} sur {{ level.down_n }}.{% else %}une hausse soutenue de {{ level.size|pct(0) }} de la demande a donné « réentraîner » en {{ horizon }} semaines à chaque départ.{% endif %}{% endmacro %}
{% macro level_why(levels) %}{% set falls = [] %}{% for year, level in levels if level.up_missed and level.down_caught > level.up_n - level.up_missed %}{% set _ = falls.append(year) %}{% endfor %}{% set missed = [] %}{% for year, level in levels if level.up_missed %}{% set _ = missed.append(year) %}{% endfor %}{% if missed %}La persistance absorbe l'essentiel d'une hausse par ses retards.{% if falls %} {% endif %}{% endif %}{% if falls %}Sur {{ and_list(falls) }}, une baisse a donné « réentraîner » plus souvent qu'une hausse : elle laisse un écart relatif plus grand qu'une hausse de même taille, car le biais se mesure contre la demande plus basse ; la position du biais hebdomadaire de l'année dans la bande de chaque saison fait le reste.{% endif %}{% endmacro %}
{# Section 7 : les recommandations d'un rejeu, comme le registre les liste. #}
{% set REC_WORD = {'retrain': 'réentraîner', 'recalibrate': 'recalibrer les intervalles', 'investigate_data': 'examiner les données'} %}
{% macro recs_list(items) %}{% for x in items %}semaine du {{ x.week_start|day }} : {{ REC_WORD[x.recommendation] }}{% if not loop.last %} ; {% endif %}{% else %}aucune{% endfor %}{% endmacro %}
{# Section 7 : chaque point de la dérogation aux règles gelées, en une phrase (report/validation.py::DEPARTURE). Un
   point que ce fichier ne connaît pas lit une variable absente : le rendu échoue. #}
{% macro departure_item(key, r_year, lags) %}{% if key == 'A3' %}Une valeur mal placée n'est replacée que si sa destination est sans ambiguïté : la destination suivante en coût doit coûter au moins le rapport minimal fois la destination choisie (rapport de qualité des données, section 3.2).{% elif key == 'A4' %}Une valeur en double hors des bornes physiques ne peut servir à aucune réparation, et aucune heure dont la valeur sort de ces bornes n'est rendue utilisable.{% elif key == 'B1' %}Le code de conception (plis de validation, seuils, modèles figés) voit chaque moment de décision comme le rejeu voit son horloge, et la demi-largeur d'un intervalle n'est calibrée que sur les jours déjà notés quand son modèle est ajusté (section 8).{% elif key == 'B2' %}La garde contre l'information future perd son terme de {{ lags[1] }} heures, qui ne pouvait jamais se déclencher seul.{% elif key == 'B3' %}Les seuils sont calibrés sur les semaines que le rejeu juge : une semaine qui contient un jour en échec de qualité, ou dont les jours ne sont pas tous dans la période, n'y entre plus (section 5).{% elif key == 'B4' %}La porte du gel s'applique dans le rejeu lui-même, si bien qu'aucun point d'entrée ne rejoue {{ r_year }} sans elle.{% elif key == 'B5' %}La vérification de l'étiquette déplacée lit aussi le registre des rejeux du dépôt (`docs/replay-ledger.json`), si bien qu'une copie neuve du dépôt voit une dérogation.{% elif key == 'B6' %}Les fausses alertes et les angles morts des règles sont aussi mesurés sur {{ r_year }}, hors échantillon (section 6).{% else %}{{ unknown_departure_item }}{% endif %}{% endmacro %}
