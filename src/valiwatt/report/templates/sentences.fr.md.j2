{# Les phrases du rapport de validation qui dépendent des résultats : chaque branche dit seulement ce que ses données
   montrent. Les calculs sont dans report/validation.py (derive) ; tests/test_report_sentences.py parcourt les
   branches. #}
{% set pct_sign = ' %' %}
{% macro sp(x, d=1) %}{{ (100 * x)|signed(d) }}{{ pct_sign }}{% endmacro %}
{% set MONTH = {1: 'janvier', 2: 'février', 3: 'mars', 4: 'avril', 5: 'mai', 6: 'juin', 7: 'juillet', 8: 'août', 9: 'septembre', 10: 'octobre', 11: 'novembre', 12: 'décembre'} %}
{% set THE_SEASON = {'winter': "l'hiver", 'spring': 'le printemps', 'summer': "l'été", 'fall': "l'automne"} %}
{% set FAIL = {'mape_high': "l'EAMP", 'bias_high': 'le biais, côté haut', 'bias_low': 'le biais, côté bas'} %}
{# Les étiquettes d'évaluation, les états et les verdicts de la règle de décision (forecast/evaluate.py), lus des
   exécutions et nommés ici. #}
{% set LABEL = {'in_sample_for_choice': "dans l'échantillon du choix de la famille et de l'entrée", 'in_sample_training': "dans l'échantillon : les propres lignes d'entraînement du modèle figé", 'rehearsal': 'répétition sur une année de conception', 'seen_by_developers': 'vu par les développeurs', 'held_out': 'données réservées', 'post_hoc': 'a posteriori'} %}
{% set STATE = {'better': 'meilleur', 'not_separated': 'non séparé', 'worse': 'pire'} %}
{% set VERDICT = {'better': 'meilleur', 'better_cold_untested': 'meilleur en moyenne, la queue froide non testable', 'not_shown_better': 'pas montré meilleur', 'worse': 'pire'} %}
{% set MODEL = {'gam_forecast': 'v2, le GAM sur la prévision (production)', 'forecast': 'la forme de v1 sur la prévision', 'persistence': 'v1 tel que livré (météo de la veille)', 'gam_observed': 'le GAM sur la météo observée (borne optimiste)', 'observed': 'la forme de v1 sur la météo observée (borne optimiste)', 'gam_forecast_late': 'le GAM, marge de disponibilité plus longue (sensibilité)', 'baseline': 'même heure, une semaine avant (référence naïve)'} %}
{% set COMPARISON = {'shipped': 'v2 contre v1 tel que livré', 'family': 'v2 contre la forme de v1 sur la même prévision', 'input': 'la forme de v1 sur la prévision contre v1 tel que livré'} %}
{% set STAGE = {'opened': "l'ouverture de l'exécution", 'inputs_read': 'la lecture des entrées', 'replayed': 'le rejeu', 'checked': 'les vérifications', 'logged': "l'enregistrement des résultats", '': 'aucune étape consignée'} %}
{% set OUTCOME = {'clean': 'propre', 'post_hoc': 'a posteriori'} %}
{% macro label(l) %}_{{ LABEL[l] }}_{% endmacro %}
{# Les années du choix : un avantage de v2 n'y est dit que si v2 y a l'erreur la plus basse des trois. #}
{% macro choice_bias(sel) %}{% if sel.mape[sel.models.production] < sel.mape[sel.models.family] and sel.mape[sel.models.production] < sel.mape[sel.models.shipped] %}l'avantage de v2 y est biaisé vers le haut par ce choix, et il ne prouve pas que v2 est meilleur{% else %}même là, v2 n'a pas l'erreur la plus basse des trois, ce qui compte contre lui{% endif %}{% endmacro %}
{% macro and_list(items) %}{% for x in items %}{{ x }}{% if loop.revindex == 2 %} et {% elif not loop.last %}, {% endif %}{% endfor %}{% endmacro %}
{% macro months(ms) %}{% set names = [] %}{% for m in ms %}{% set _ = names.append(MONTH[m]) %}{% endfor %}{{ and_list(names) }}{% endmacro %}
{% macro groups(seasons, deciles, hours=[]) %}{% set parts = [] %}{% set names = [] %}{% for s in seasons %}{% set _ = names.append(THE_SEASON[s]) %}{% endfor %}{% if seasons %}{% set _ = parts.append(and_list(names)) %}{% endif %}{% if hours %}{% set _ = parts.append(('le bloc horaire ' if hours|length == 1 else 'les blocs horaires ') ~ and_list(hours)) %}{% endif %}{% if deciles %}{% set _ = parts.append(('le décile de charge prévue ' if deciles|length == 1 else 'les déciles de charge prévue ') ~ and_list(deciles)) %}{% endif %}{{ parts|join(' ; ') }}{% endmacro %}
{# Le statut de la fiche du modèle (section 8.5 du plan), de evaluate.status sur le test de référence de 2025 seul :
   chaque formulation nomme sa portée. « Meilleur en moyenne, la queue froide non testable » compte comme meilleur, et
   la phrase le dit. #}
{% macro cold_clause(status, record) %}{% set which = [] %}{% if record and record.verdict and record.verdict.shipped == 'better_cold_untested' %}{% set _ = which.append('de la comparaison à v1 tel que livré') %}{% endif %}{% if status == 'confirmed' and record and record.verdict and record.verdict.family == 'better_cold_untested' %}{% set _ = which.append('de la comparaison à la forme de v1 sur la même prévision') %}{% endif %}{% if which %} « Meilleur en moyenne, la queue froide non testable » compte comme meilleur, et c'est le verdict {{ and_list(which) }} : la queue froide de 2025 n'était pas testable.{% endif %}{% endmacro %}
{% macro status_line(status, record, say, years) %}{% if status == 'candidate' %}**Statut : candidat.** Choisi sur {{ years[0] }}–{{ years[1] }} (dans l'échantillon du choix), montré sur 2024 vue par les développeurs ; le test sur données réservées, 2025, est en attente.{% elif status == 'confirmed' %}**Statut : erreur horaire plus faible que v1 tel que livré et que la forme de v1 sur la même prévision, {{ say.held_out }}.**{{ cold_clause(status, record) }}{% elif status == 'input_only' %}**Statut : erreur horaire plus faible que v1 tel que livré {{ say.held_out }} ; le GAM n'est pas montré meilleur que la forme de v1 sur la même prévision.**{{ cold_clause(status, record) }}{% elif status == 'not_confirmed' %}**Statut : pas montré avec une erreur horaire plus faible que v1 tel que livré {{ say.held_out }}.**{% elif status == 'post_hoc' %}**Statut : 2025 rejouée sous la décision du propriétaire qu'elle est a posteriori : ce n'est pas un test sur données réservées.**{% elif status == 'unfinished' %}**Statut : le test de référence de 2025 n'a pas fini : aucune affirmation sur des données réservées.**{% else %}{{ unknown_status }}{% endif %}{% endmacro %}
{# Les affirmations qu'un 2025 propre qui ne confirme pas v2 retire, nommées (section 8.5 du plan). #}
{% set CLAIM = {'shipped': 'que v2 a une erreur horaire plus faible que v1 tel que livré', 'family': 'que le GAM mérite sa place face à la forme de v1 sur la même prévision'} %}
{% macro withdrawn(keys) %}{% set names = [] %}{% for k in keys %}{% set _ = names.append(CLAIM[k]) %}{% endfor %}{{ and_list(names) }}{% endmacro %}
{# Sous- et sur-couverture, sur les IC 95 % tels qu'imprimés (report/validation.py::coverage_sides). `hour` porte les
   blocs horaires sous- et sur-couverts, nommés comme leur tableau les nomme ; sans lui, la phrase ne parle que des
   saisons et des déciles, et le dit. #}
{% macro coverage_sides(season, decile, nominal, hour=none) %}{% set hb = hour if hour is not none else {'under': [], 'over': []} %}{% if season.under or decile.under or hb.under %}Sous-couverts, leur IC 95 % entièrement sous le nominal de {{ nominal|pct(0) }} : {{ groups(season.under, decile.under, hb.under) }}.{% elif hour is none %}Aucune saison ni aucun décile de charge n'a son IC 95 % entièrement sous le nominal de {{ nominal|pct(0) }}.{% else %}Aucune saison, aucun bloc horaire ni aucun décile de charge n'a son IC 95 % entièrement sous le nominal de {{ nominal|pct(0) }}.{% endif %} {% if season.over or decile.over or hb.over %}Sur-couverts, l'IC entièrement au-dessus : {{ groups(season.over, decile.over, hb.over) }}.{% elif hour is none %}Aucun groupe (saison ou décile de charge) n'a son IC entièrement au-dessus.{% else %}Aucun groupe (saison, bloc horaire ou décile de charge) n'a son IC entièrement au-dessus.{% endif %}{% endmacro %}
{# Ce que le tableau de puissance d'un rejeu montre (report/validation.py::detection_limits). #}
{% macro power_limit(L, year, horizon) %}{% if L.every_from is not none %}Sur {{ year }}, un écart soutenu de ±{{ L.every_from|pct(0) }} ou plus entre la demande et la prévision a donné « réentraîner » en {{ horizon }} semaines au plus à chacun des {{ L.starts }} départs{% else %}Sur {{ year }}, même le plus grand écart mesuré entre la demande et la prévision, ±{{ L.sizes[-1]|pct(0) }}, n'a pas donné « réentraîner » en {{ horizon }} semaines à tous les {{ L.starts }} départs{% endif %} ; un écart de +{{ L.smallest|pct(0) }}, à {{ L.smallest_by_sign.up.caught }} des {{ L.smallest_by_sign.up.cases }} départs, et de −{{ L.smallest|pct(0) }}, à {{ L.smallest_by_sign.down.caught }} des {{ L.smallest_by_sign.down.cases }}. Sur {{ year }}, des intervalles réduits à × {{ L.strongest|num(1) }} de leur demi-largeur ont donné « recalibrer » à {{ L.strongest_caught.caught }} des {{ L.strongest_caught.cases }} départs{% if L.milder_max == 0 %} ; aucune réduction moindre (jusqu'à × {{ L.mildest|num(1) }}) ne l'a donné{% elif L.milder_max is not none %} ; des réductions moindres (jusqu'à × {{ L.mildest|num(1) }}), à {{ L.milder_max }} des {{ L.half_width_starts }} départs au plus{% endif %}.{% endmacro %}
{# Une semaine, comme le moniteur la juge. #}
{% macro week_ev(w) %}EAMP {{ w.stats.mape|pct(2) }}{% if w.flags.mape_high %} hors seuil{% endif %}, biais {{ sp(w.stats.rel_bias, 2) }}{% if w.flags.bias_high or w.flags.bias_low %} hors bande{% endif %}{% endmacro %}
{% macro stat(failure, x) %}{% if failure == 'mape_high' %}{{ x|pct(2) }}{% else %}{{ sp(x, 2) }}{% endif %}{% endmacro %}
{# Les semaines où la première formulation de la règle 2 dit « réentraîner », puis pourquoi la règle retenue l'a dit
   ou non (report/validation.py::near_misses). #}
{% macro near_list(items) %}{% for d in items %}la semaine du {{ d.week_start|day }} (la semaine d'avant : {{ week_ev(d.weeks[0]) }} ; celle-ci : {{ week_ev(d.weeks[1]) }}){% if not loop.last %}, puis {% endif %}{% endfor %}{% endmacro %}
{% macro near_why(items, trim_days) %}{% for d in items %}{% if not loop.first %} {% endif %}Semaine du {{ d.week_start|day }} : {% if d.kept_by == 'fired' %}la règle retenue a dit « réentraîner » elle aussi.{% elif d.kept_by == 'different' %}les deux semaines ne montrent pas la même défaillance, et la règle retenue n'y voit rien.{% elif d.kept_by == 'echo' %}l'EAMP est hors seuil, étendue, les deux semaines, mais le biais sort de sa bande d'un côté puis de l'autre : la règle retenue l'écarte comme un écho.{% else %}{% for s in d.same %}{{ FAIL[s.failure] }} est au-delà de son seuil les deux semaines, mais, sans les {{ trim_days }} jours les plus extrêmes de chaque semaine, vaut {{ stat(s.failure, s.trimmed[0]) }} puis {{ stat(s.failure, s.trimmed[1]) }}{% if s.thresholds_equal %} pour un seuil de {{ stat(s.failure, s.threshold) }}{% endif %} : {% if s.broad|select|list|length == 0 %}aucune des deux semaines n'est hors seuil, étendue{% else %}l'une des deux semaines n'est pas hors seuil, étendue{% endif %}{% if not loop.last %} ; {% endif %}{% endfor %} ; la règle retenue n'y voit donc rien.{% if d.bias_flips and not d.bias_flagged %} Le biais change de signe d'une semaine à l'autre, mais reste dans sa bande les deux semaines : ce n'est pas l'exclusion de l'écho qui joue.{% endif %}{% endif %}{% endfor %}{% endmacro %}
{% macro pp(x, d=2) %}{{ (100 * x)|signed(d) }} pt{% endmacro %}
{% macro ppci(lo, hi, d=2) %}[{{ pp(lo, d) }} ; {{ pp(hi, d) }}]{% endmacro %}
{% macro span(years) %}{{ years[0] }}–{{ years[1] }}{% endmacro %}
{% macro recs(n) %}{% if n == 0 %}aucune recommandation{% elif n == 1 %}1 recommandation{% else %}{{ n }} recommandations{% endif %}{% endmacro %}
{# L'intervalle de la différence du printemps 2020, avec l'erreur de Monte-Carlo de ses
   bornes (report/validation.py::shift_difference, shift_verdict). #}
{% set BOUND = {'low': 'inférieure', 'high': 'supérieure'} %}
{% macro mc_se(x, d) %}{{ (100 * x)|num(d) }} pt{% endmacro %}
{% macro diff_verdict(d) %}{% if d.verdict == 'undetermined' %}indéterminé à cette résolution : la borne {{ BOUND[d.near.bound] }}{% if d.near.by == 'mc' %}, {{ pp(d.near.value, d.digits) }}, n'est pas à plus de {{ d.mc_multiple }} erreurs types de Monte-Carlo ({{ mc_se(d.near.se, d.digits) }}) de zéro{% else %} s'arrondit à zéro au centième de point près{% endif %}, et la règle de la section 1 ne tranche pas{% elif d.verdict == 'confirmed' %}selon la règle de la section 1, l'écart est confirmé{% else %}selon la règle de la section 1, l'écart n'est pas confirmé{% endif %} ({{ d.draws|num }} tirages par côté, en {{ d.batches }} lots indépendants de {{ d.batch_draws|num }} ; erreur type de Monte-Carlo des bornes, mesurée par leur dispersion d'un lot à l'autre : {{ mc_se(d.mc_se_low, d.digits) }} et {{ mc_se(d.mc_se_high, d.digits) }}{% if d.verdict != 'undetermined' %} ; bornes à cette précision : {{ pp(d.ci95_low, d.digits) }} et {{ pp(d.ci95_high, d.digits) }}, chacune à plus de {{ d.mc_multiple }} de ses erreurs types de zéro{% endif %}){% endmacro %}
{% macro spring_card(sh, d) %}{% if sh.separated %}écart confirmé par des intervalles disjoints{% else %}écart non confirmé par des intervalles disjoints{% endif %} ; l'intervalle de la différence {% if d.verdict == 'confirmed' %}confirme l'écart{% elif d.verdict == 'not_confirmed' %}ne confirme pas l'écart{% elif d.near.by == 'mc' %}ne tranche pas à cette résolution : une borne n'est pas à plus de {{ d.mc_multiple }} erreurs types de Monte-Carlo de zéro{% else %}ne tranche pas à cette résolution : une borne s'arrondit à zéro{% endif %}{% endmacro %}
{# `last_fold` et `hours` (les blocs horaires sous-couverts, nommés comme leur tableau) : la période entière et tous
   les tableaux de la section 5 ; sans eux, la phrase ne nomme que le début et ne parle que des saisons et des déciles. #}
{% macro brief_coverage(nominal, overall, first_fold, sides, last_fold=none, hours=none) %}Ses intervalles à {{ nominal|pct(0) }} ont contenu la demande {{ overall|pct(1) }} du temps {% if last_fold is not none %}de {{ first_fold }} à {{ last_fold }}{% else %}depuis {{ first_fold }}{% endif %}{% if sides.overall.under %}, moins que le nominal, IC 95 % compris{% elif sides.overall.over %}, plus que le nominal, IC 95 % compris{% else %}, et l'IC 95 % de cette couverture contient le nominal{% endif %}. {% set hb = hours if hours is not none else [] %}{% if sides.season.under or sides.decile.under or hb %}Ils en contiennent moins que promis dans ces groupes : {{ groups(sides.season.under, sides.decile.under, hb) }} (section 5).{% elif hours is none %}Aucune saison ni aucun décile de charge n'est sous-couvert au sens de la section 5.{% else %}Aucune saison ni aucun décile de charge n'est sous-couvert au sens de la section 5, ni aucun bloc horaire.{% endif %}{% endmacro %}
{% macro brief_peak(peak, years, in_month, above) %}Aux {{ peak.hours|length }} heures les plus chargées de {{ span(years) }}{% if in_month %}, toutes en {{ peak.named_month }}{% endif %}, {% if peak.evaluated == 0 %}aucun intervalle de prévision n'est calculé{% elif peak.covered == peak.evaluated %}la demande est restée dans l'intervalle chaque fois ({{ peak.evaluated }} heures jugées){% else %}la demande est sortie de l'intervalle {{ peak.evaluated - peak.covered }} fois sur {{ peak.evaluated }}{% if above == peak.evaluated - peak.covered %}, toujours par le haut{% endif %}{% endif %}.{% endmacro %}
{# `power_horizon` : l'horizon du tableau de puissance, qui n'est pas celui du changement de niveau ; sans lui, la
   phrase ne le dit pas. #}
{% macro brief_misses(level, L, p_year, r_year, horizon, level24=none, power_horizon=none) %}Le rapport mesure aussi ce que le moniteur pouvait manquer : sur {{ p_year }}, une hausse soutenue de {{ level.size|pct(0) }} de la demande a donné « réentraîner » en {{ horizon }} semaines à {{ level.up_n - level.up_missed }} des {{ level.up_n }} départs{% if level24 %}, et sur {{ r_year }} (vu par les développeurs), à {{ level24.up_n - level24.up_missed }} des {{ level24.up_n }}{% endif %} ; sur {{ r_year }}, un écart soutenu de ±{{ L.smallest|pct(0) }} entre la demande et la prévision{% if power_horizon is not none %} l'a donné en {{ power_horizon }} semaines à {{ L.smallest_by_sign.up.caught + L.smallest_by_sign.down.caught }} des {{ L.smallest_by_sign.up.cases + L.smallest_by_sign.down.cases }} cas{% else %}, à {{ L.smallest_by_sign.up.caught + L.smallest_by_sign.down.caught }} des {{ L.smallest_by_sign.up.cases + L.smallest_by_sign.down.cases }} cas{% endif %} (sections 7, 8 et 10).{% endmacro %}
{# Section 11 : le mot du résultat d'un bris, et le changement de niveau du monde synthétique face à la section 10. #}
{% macro break_result(row) %}{% if row.outcome != 'passed' %}ÉCHEC{% elif row.control %}resté silencieux{% else %}déclenché{% endif %}{% endmacro %}
{% macro level_shift_note(label, world, level, p_year, horizon) %}Le bris « {{ label }} » multiplie la demande du monde synthétique par {{ (1 + world.level_shift)|num(2) }}, une hausse de {{ world.level_shift|pct(0) }}. {% if level.up_missed %}Sur les vraies heures de {{ p_year }}, une hausse de {{ level.size|pct(0) }} n'a pas donné « réentraîner » en {{ horizon }} semaines à {{ level.up_missed }} des {{ level.up_n }} départs (section 10) : la règle peut se déclencher, mais {% if level.up_missed == level.up_n %}elle n'a vu une telle hausse dans la vraie demande à aucun départ{% else %}elle n'a pas vu une telle hausse dans la vraie demande à chaque départ{% endif %}.{% else %}Sur les vraies heures de {{ p_year }}, une hausse de {{ level.size|pct(0) }} a donné « réentraîner » en {{ horizon }} semaines à chaque départ (section 10).{% endif %}{% endmacro %}
{% macro level_shift_note_replay(level, r_year, horizon) %}Sur les vraies heures de {{ r_year }} (vu par les développeurs), {% if level.up_missed %}la même hausse n'a pas donné « réentraîner » en {{ horizon }} semaines à {{ level.up_missed }} des {{ level.up_n }} départs{% else %}la même hausse a donné « réentraîner » en {{ horizon }} semaines à chaque départ{% endif %} (section 10).{% endmacro %}
{# Section 6 : les semaines écartées des seuils, décomptées par l'exécution de validation. Singulier pour 0 et 1. #}
{% macro set_aside(nx24, nx23, years24, years23, p_year) %}Pour ces raisons, {{ nx24 }} semaine{{ 's' if nx24 > 1 }} de {{ span(years24) }} {{ 'ont' if nx24 > 1 else 'a' }} été écartée{{ 's' if nx24 > 1 }} ({{ nx23 }} de {{ span(years23) }} pour le rejeu de {{ p_year }}){% if nx24 or nx23 %} ; l'exécution de validation consigne chacune avec sa raison{% endif %}.{% endmacro %}
{# Section 10 : les fausses alertes et les angles morts mesurés sur une année (report/validation.py::episode_limits,
   level_shift). #}
{% macro episode_limit(E, year, mild) %}sur {{ year }}, {% if E.worst %}« réentraîner » jusqu'à {{ E.share|pct(1) }} des départs ({{ E.worst.days }} jours à × {{ E.worst.factor|num(2) }}) et au plus {{ E.mild|pct(1) }} pour un épisode de ±{{ mild|pct(0) }}{% else %}aucun « réentraîner »{% endif %}, {% if E.recal_worst %}« recalibrer » jusqu'à {{ E.recal_share|pct(1) }} des départs ({{ E.recal_worst.days }} jours à × {{ E.recal_worst.factor|num(2) }}){% else %}aucun « recalibrer »{% endif %}{% endmacro %}
{% macro level_limit(level, year, horizon) %}Sur {{ year }}, {% if level.up_missed %}une hausse soutenue de {{ level.size|pct(0) }} de la demande n'a pas donné « réentraîner » en {{ horizon }} semaines à {{ level.up_missed }} départ{{ 's' if level.up_missed > 1 }} sur {{ level.up_n }} ({{ 'départs' if level.up_missed > 1 else 'départ' }} de {{ months(level.missed_months) }}), et une baisse de {{ level.size|pct(0) }} l'a donné à {{ level.down_caught }} sur {{ level.down_n }}.{% else %}une hausse soutenue de {{ level.size|pct(0) }} de la demande a donné « réentraîner » en {{ horizon }} semaines à chaque départ.{% endif %}{% endmacro %}
{% macro level_why(levels) %}{% set falls = [] %}{% for year, level in levels if level.up_missed and level.down_caught > level.up_n - level.up_missed %}{% set _ = falls.append(year) %}{% endfor %}{% set missed = [] %}{% for year, level in levels if level.up_missed %}{% set _ = missed.append(year) %}{% endfor %}{% if missed %}Les retards de la demande absorbent l'essentiel d'une hausse.{% if falls %} {% endif %}{% endif %}{% if falls %}Sur {{ and_list(falls) }}, une baisse a donné « réentraîner » plus souvent qu'une hausse : elle laisse un écart relatif plus grand qu'une hausse de même taille, car le biais se mesure contre la demande plus basse ; la position du biais hebdomadaire de l'année dans la bande de chaque saison fait le reste.{% endif %}{% endmacro %}
{# Les recommandations d'un rejeu, comme le registre les liste. #}
{% set REC_WORD = {'retrain': 'réentraîner', 'recalibrate': 'recalibrer les intervalles', 'investigate_data': 'examiner les données'} %}
{% macro recs_list(items) %}{% for x in items %}semaine du {{ x.week_start|day }} : {{ REC_WORD[x.recommendation] }}{% if not loop.last %} ; {% endif %}{% else %}aucune{% endfor %}{% endmacro %}
{# La dérogation aux règles gelées de v1, point par point (report/validation.py::DEPARTURE) : le rapport de v1 la
   décrivait ; ce fichier la garde pour un rejeu de v1. Un point que ce fichier ne connaît pas lit une variable
   absente : le rendu échoue. #}
{% macro departure_item(key, r_year, lags) %}{% if key == 'A3' %}Une valeur mal placée n'est replacée que si sa destination est sans ambiguïté : la destination suivante en coût doit coûter au moins le rapport minimal fois la destination choisie (rapport de qualité des données, section 3.2).{% elif key == 'A4' %}Une valeur en double hors des bornes physiques ne peut servir à aucune réparation, et aucune heure dont la valeur sort de ces bornes n'est rendue utilisable.{% elif key == 'B1' %}Le code de conception (plis de validation, seuils, modèles figés) voit chaque moment de décision comme le rejeu voit son horloge, et la demi-largeur d'un intervalle n'est calibrée que sur les jours déjà notés quand son modèle est ajusté.{% elif key == 'B2' %}La garde contre l'information future perd son terme de {{ lags[1] }} heures, qui ne pouvait jamais se déclencher seul.{% elif key == 'B3' %}Les seuils sont calibrés sur les semaines que le rejeu juge : une semaine qui contient un jour en échec de qualité, ou dont les jours ne sont pas tous dans la période, n'y entre plus.{% elif key == 'B4' %}La porte du gel s'applique dans le rejeu lui-même, si bien qu'aucun point d'entrée ne rejoue {{ r_year }} sans elle.{% elif key == 'B5' %}La vérification de l'étiquette déplacée lit aussi le registre des rejeux du dépôt (`docs/replay-ledger.json`), si bien qu'une copie neuve du dépôt voit une dérogation.{% elif key == 'B6' %}Les fausses alertes et les angles morts des règles sont aussi mesurés sur {{ r_year }}.{% else %}{{ unknown_departure_item }}{% endif %}{% endmacro %}
{# Les alertes des chocs d'un seul jour, par année (report/validation.py::episode_limits, `one_day`). La part sans aide
   n'est mesurée que pour « réentraîner ». #}
{% macro one_day_alarms(items) %}{% if not items %}{{ unread_one_day_years }}{% endif %}**Alertes des chocs d'un seul jour** : {% for year, O in items %}sur {{ year }}, {{ O.retrain|num }} « réentraîner » (dont {{ O.retrain_clean|num }} sans aide) et {{ O.recalibrate|num }} « recalibrer », sur {{ O.cases|num }} cas (départs × facteurs){% if not loop.last %} ; {% endif %}{% endfor %}. Un mauvais jour ne peut en donner qu'en complétant des jours en échec que les semaines contenaient déjà et que la coupe écartait jusque-là ; la part sans aide n'est mesurée que pour « réentraîner », et les semaines en cause sont dans l'exécution.{% endmacro %}
{# Un rejeu antérieur à une dérogation (report/validation.py::departure) : terminé, montré du magasin ou du registre ;
   un départ qui n'a pas fini, montré comme tel ; ou, nommé par un rejeu montré du registre, gardé seulement dans le
   magasin de la machine qui l'a fait tourner. #}
{% macro predecessor(d, say) %}{% if d.absent %}le départ `{{ d.id }}`, qui n'a jamais fini : il n'est dans aucun registre, et seul le magasin d'exécutions de la machine qui l'a fait tourner le garde{% elif d.unfinished %}le départ `{{ d.id }}` (règles du commit `{{ d.freeze_commit|short }}`), qui {{ say.unfinished }} : arrêté à l'étape « {{ STAGE[d.stage] }} »{% if d.error %}, erreur `{{ d.error }}`{% endif %} ; ce n'est pas un résultat{% else %}le rejeu `{{ d.id }}` (règles du commit `{{ d.freeze_commit|short }}`, EAMP {{ d.summary.mape.mean|pct(2) }}, couverture {{ d.summary.coverage.mean|pct(1) }}){% if d.recorded %}, {{ say.ledger_label|lower|replace('.', '') }}{% endif %}{% endif %}{% endmacro %}
