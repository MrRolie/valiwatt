{# Les phrases du rapport de v3 qui dépendent des résultats, et les noms qu'il donne aux modèles, aux contrastes, aux
   états et aux verdicts de la règle de décision (forecast/evaluate.py), lus des exécutions. #}
{% set MODEL = {'v3': 'v3 (production)', 'v2_noon': 'la forme de v2 à midi', 'v1_noon': 'la forme de v1 à midi', 'v2_midnight': 'la forme de v2 à minuit', 'baseline': 'la même heure une semaine plus tôt (référence naïve)', 'v3_no_day_mean': 'v3 sans le froid moyen du jour', 'v3_no_lag_day': "v3 sans le froid moyen de l'avant-veille", 'v3_no_wind': 'v3 sans le vent par le froid', 'v3_late': 'v3, la marge de disponibilité plus longue', 'v3_observed': "v3 sur la température observée (borne optimiste)"} %}
{% set TERM = {'day_mean_cold': 'froid moyen du jour', 'lag_day_mean_cold': "froid moyen de l'avant-veille", 'wind_cold': 'vent par le froid'} %}
{# L'unité de chaque terme : son froid est compté en degrés sous la base, que le rapport écrit à côté. #}
{% set UNIT = {'day_mean_cold': 'MW par °C de froid', 'lag_day_mean_cold': 'MW par °C de froid', 'wind_cold': 'MW par km/h et par °C de froid'} %}
{% set CONTRAST = {'terms': 'termes : v3 moins la forme de v2 à midi', 'family': 'famille : la forme de v2 à midi moins la forme de v1 à midi', 'whole': 'changement entier à midi : v3 moins la forme de v1 à midi (rapporté, jamais jugé)'} %}
{% set SUBSET = {'all': 'toutes les heures communes', 'cold': 'la queue froide', 'event_windows': "les fenêtres d'événements"} %}
{% set STATE = {'better': 'meilleur', 'not_separated': 'non séparé', 'worse': 'pire'} %}
{% set TERMS_VERDICT = {'better': 'meilleur', 'better_windows_cold_untested': "meilleur dans les fenêtres d'événements, la queue froide non testable", 'not_shown_better': 'pas montré meilleur', 'worse': 'pire', 'not_testable': 'non testable'} %}
{% set FAMILY_VERDICT = {'better': 'meilleur', 'better_cold_untested': 'meilleur en moyenne, la queue froide non testable', 'not_shown_better': 'pas montré meilleur', 'worse': 'pire'} %}
{% set EVAL = {'held_out': 'données réservées', 'post_hoc': 'a posteriori', 'seen_by_developers': 'vu par les développeurs'} %}
{% set STANDING = {'clean': 'propre', 'post_hoc': 'a posteriori', '': 'aucune'} %}
{% set REC = {'retrain': 'réentraîner', 'recalibrate': 'recalibrer les intervalles', 'investigate_data': 'examiner les données'} %}
{% set REASON = {'no_run_available': 'aucune prévision disponible avant l’origine', 'no_covering_run': 'aucune des prévisions disponibles ne couvre le jour', 'lag_day_temperature_missing': "la moyenne de l'avant-veille manque", 'calendar': 'le calendrier', 'no forecast': 'pas de prévision', 'lag168': 'la demande de la semaine précédente manque', 'temp_forecast': 'la température prévue manque', 'temp_forecast_late': 'la température prévue manque', 'wind_forecast': 'le vent prévu manque', 'wind_forecast_late': 'le vent prévu manque', 'daymean_forecast': 'la moyenne prévue du jour manque', 'daymean_forecast_late': 'la moyenne prévue du jour manque', 'temp_observed': 'la température observée manque', 'daymean_observed': 'la moyenne observée du jour manque', 'lagday_observed': "la moyenne de l'avant-veille manque", 'lag48': 'la demande de deux jours plus tôt manque', 'lag24': 'la demande de la veille manque'} %}
{% set ROLE = {'data_quality': 'qualité des données', 'validation': 'validation'} %}
{# A run's role in the freeze record (freeze_record.ROLES), its year read from the context. #}
{% macro role_name(name, Y) %}{% if name == 'frozen_2024' %}modèles figés pour {{ Y.seen }}{% elif name == 'rehearsal_2024' %}répétition de {{ Y.seen }}{% elif name == 'frozen_2025' %}modèles figés pour {{ Y.held }}{% else %}{{ ROLE[name] }}{% endif %}{% endmacro %}
{% set RECOMMENDATION = {'keep_v2_noon': 'garder la forme de v2 à midi', 'review_family': 'revoir la famille'} %}
{% set WINDOW = {'morning': 'matin', 'evening': 'soir'} %}
{% macro pp(x, d=2) %}{{ (100 * x)|signed(d) }} pt{% endmacro %}
{% macro ppci(lo, hi, d=2) %}[{{ pp(lo, d) }} ; {{ pp(hi, d) }}]{% endmacro %}
{% macro ci(lo, hi, d=2) %}[{{ lo|pct(d) }} ; {{ hi|pct(d) }}]{% endmacro %}
{# Pourquoi une heure n'a pas de prévision : chaque raison par sa clé (« clé (sous-clé) » pour un rejeu), jamais le texte
   de l'exécution ; une clé sans phrase fait refuser la page. #}
{% macro why(text) %}{% set parts = [] %}{% for one in (text or 'no forecast').split(', ') %}{% set kv = one.split(' (', 1) %}{% if kv|length == 2 %}{% set _ = parts.append(REASON[kv[0]] ~ ' (' ~ REASON[kv[1].rstrip(')')] ~ ')') %}{% else %}{% set _ = parts.append(REASON[one] ~ '') %}{% endif %}{% endfor %}{% for x in parts %}{{ x }}{% if loop.revindex == 2 %} et {% elif not loop.last %}, {% endif %}{% endfor %}{% endmacro %}
{% macro yes(b) %}{% if b %}oui{% else %}non{% endif %}{% endmacro %}
{% macro and_list(items) %}{% for x in items %}{{ x }}{% if loop.revindex == 2 %} et {% elif not loop.last %}, {% endif %}{% endfor %}{% endmacro %}
{# La phrase de statut (section 8.5 du plan), du seul test de référence de 2025 de v3 ; « meilleur dans les fenêtres
   d'événements, la queue froide non testable » et « meilleur en moyenne, la queue froide non testable » comptent
   comme meilleurs, et la phrase le dit. #}
{% macro cold_clause(verdict) %}{% if verdict and verdict.terms == 'better_windows_cold_untested' %} Pour les termes, la queue froide n'était pas testable.{% endif %}{% if verdict and verdict.family == 'better_cold_untested' %} Pour la famille, la queue froide n'était pas testable.{% endif %}{% endmacro %}
{% macro status_line(status, verdict, Y) %}{% if status == 'candidate' %}**Statut : candidat.** Choisi sur {{ Y.first }}–{{ Y.last }} (dans l'échantillon du choix), montré sur {{ Y.seen }} vue par les développeurs ; le test sur données réservées, {{ Y.held }}, est en attente.{% elif status == 'both_better' %}**Statut : les termes abaissent l'erreur horaire de la prévision de midi dans les fenêtres d'événements de pointe, et le modèle additif l'abaisse face à la forme de v1, sur données réservées ({{ Y.held }}).**{{ cold_clause(verdict) }}{% elif status == 'terms_only' %}**Statut : les termes abaissent l'erreur horaire de la prévision de midi dans les fenêtres d'événements de pointe, sur données réservées ({{ Y.held }}) ; il n'est pas montré que le modèle additif fasse mieux que la forme de v1.**{{ cold_clause(verdict) }}{% elif status == 'family_only' %}**Statut : il n'est pas montré que les termes abaissent l'erreur horaire de la prévision de midi dans les fenêtres d'événements de pointe ; le modèle additif l'abaisse face à la forme de v1, sur données réservées ({{ Y.held }}).**{{ cold_clause(verdict) }}{% elif status == 'neither' %}**Statut : il n'est montré ni que les termes ni que le modèle additif abaissent l'erreur horaire de la prévision de midi sur données réservées ({{ Y.held }}).**{% elif status == 'post_hoc' %}**Statut : a posteriori.** Le test de référence de {{ Y.held }} est a posteriori (section 4) : il ne soutient aucune affirmation sur données réservées.{% elif status == 'unfinished' %}**Statut : inachevé.** Le test de référence de {{ Y.held }} a commencé et n'a pas fini (section 4) : aucune affirmation.{% else %}{{ unknown_status }}{% endif %}{% endmacro %}
{% macro recommendation_line(kinds) %}**Recommandation, dans la forme du moniteur : {% for k in kinds %}{{ RECOMMENDATION[k] }}{% if k == 'keep_v2_noon' %} (la prévision de midi sans les termes){% endif %}{% if not loop.last %} ; {% endif %}{% endfor %}.** Chaque affirmation que ce verdict touche est retirée. Rien ne bascule de soi-même : le modèle en usage ensuite relève de la décision du propriétaire.{% endmacro %}
