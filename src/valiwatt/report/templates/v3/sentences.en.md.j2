{# The v3 report's sentences that depend on the results, and the names it gives the models, the contrasts, the
   states and the verdicts of the decision rule (forecast/evaluate.py), read from the runs. #}
{% set MODEL = {'v3': 'v3 (production)', 'v2_noon': "v2's form at noon", 'v1_noon': "v1's form at noon", 'v2_midnight': "v2's form at midnight", 'baseline': 'the same hour one week earlier (naive baseline)', 'v3_no_day_mean': "v3 without the day's mean cold", 'v3_no_lag_day': "v3 without the lag day's mean cold", 'v3_no_wind': 'v3 without wind with cold', 'v3_late': 'v3, the longer availability margin', 'v3_observed': 'v3 on the observed temperature (optimistic bound)'} %}
{% set TERM = {'day_mean_cold': "the day's mean cold", 'lag_day_mean_cold': "the lag day's mean cold", 'wind_cold': 'wind with cold'} %}
{# Each term's unit: its cold counts degrees below the base, which the report writes beside it. #}
{% set UNIT = {'day_mean_cold': 'MW per °C colder', 'lag_day_mean_cold': 'MW per °C colder', 'wind_cold': 'MW per km/h per °C colder'} %}
{% set CONTRAST = {'terms': "terms: v3 minus v2's form at noon", 'family': "family: v2's form at noon minus v1's form at noon", 'whole': "the whole change at noon: v3 minus v1's form at noon (reported, never judged)"} %}
{% set SUBSET = {'all': 'all common hours', 'cold': 'the cold tail', 'event_windows': 'the event windows'} %}
{% set STATE = {'better': 'better', 'not_separated': 'not separated', 'worse': 'worse'} %}
{% set TERMS_VERDICT = {'better': 'better', 'better_windows_cold_untested': 'better in the event windows, the cold tail not testable', 'not_shown_better': 'not shown better', 'worse': 'worse', 'not_testable': 'not testable'} %}
{% set FAMILY_VERDICT = {'better': 'better', 'better_cold_untested': 'better on average, the cold tail not testable', 'not_shown_better': 'not shown better', 'worse': 'worse'} %}
{% set EVAL = {'held_out': 'held-out data', 'post_hoc': 'post hoc', 'seen_by_developers': 'seen by the developers'} %}
{% set STANDING = {'clean': 'clean', 'post_hoc': 'post hoc', '': 'none'} %}
{% set REC = {'retrain': 'retrain', 'recalibrate': 'recalibrate the intervals', 'investigate_data': 'investigate the data'} %}
{% set REASON = {'no_run_available': 'no forecast available before the origin', 'no_covering_run': 'none of the available forecasts covers the day', 'lag_day_temperature_missing': "the lag day's mean is missing", 'calendar': 'the calendar', 'no forecast': 'no forecast', 'lag168': "the week before's demand is missing", 'temp_forecast': 'the forecast temperature is missing', 'temp_forecast_late': 'the forecast temperature is missing', 'wind_forecast': 'the forecast wind is missing', 'wind_forecast_late': 'the forecast wind is missing', 'daymean_forecast': "the day's forecast mean is missing", 'daymean_forecast_late': "the day's forecast mean is missing", 'temp_observed': 'the observed temperature is missing', 'daymean_observed': "the day's observed mean is missing", 'lagday_observed': "the lag day's mean is missing", 'lag48': "the demand two days before is missing", 'lag24': "the day before's demand is missing"} %}
{% set ROLE = {'data_quality': 'data quality', 'validation': 'validation'} %}
{# A run's role in the freeze record (freeze_record.ROLES), its year read from the context. #}
{% macro role_name(name, Y) %}{% if name == 'frozen_2024' %}models frozen for {{ Y.seen }}{% elif name == 'rehearsal_2024' %}the {{ Y.seen }} rehearsal{% elif name == 'frozen_2025' %}models frozen for {{ Y.held }}{% else %}{{ ROLE[name] }}{% endif %}{% endmacro %}
{% set RECOMMENDATION = {'keep_v2_noon': "keep v2's form at noon", 'review_family': 'review the family'} %}
{% set WINDOW = {'morning': 'morning', 'evening': 'evening'} %}
{% macro pp(x, d=2) %}{{ (100 * x)|signed(d) }} pp{% endmacro %}
{% macro ppci(lo, hi, d=2) %}[{{ pp(lo, d) }}, {{ pp(hi, d) }}]{% endmacro %}
{% macro ci(lo, hi, d=2) %}[{{ lo|pct(d) }}, {{ hi|pct(d) }}]{% endmacro %}
{# Why an hour has no forecast: each reason by its key ("key (sub-key)" for a replay), never the run's own text; a key
   with no phrase makes the page refuse. #}
{% macro why(text) %}{% set parts = [] %}{% for one in (text or 'no forecast').split(', ') %}{% set kv = one.split(' (', 1) %}{% if kv|length == 2 %}{% set _ = parts.append(REASON[kv[0]] ~ ' (' ~ REASON[kv[1].rstrip(')')] ~ ')') %}{% else %}{% set _ = parts.append(REASON[one] ~ '') %}{% endif %}{% endfor %}{% for x in parts %}{{ x }}{% if loop.revindex == 2 %} and {% elif not loop.last %}, {% endif %}{% endfor %}{% endmacro %}
{% macro yes(b) %}{% if b %}yes{% else %}no{% endif %}{% endmacro %}
{% macro and_list(items) %}{% for x in items %}{{ x }}{% if loop.revindex == 2 %} and {% elif not loop.last %}, {% endif %}{% endfor %}{% endmacro %}
{# The status sentence (plan section 8.5), from v3's 2025 test of record alone; "better in the event windows, the cold
   tail not testable" and "better on average, the cold tail not testable" count as better, and the sentence says so. #}
{% macro cold_clause(verdict) %}{% if verdict and verdict.terms == 'better_windows_cold_untested' %} For the terms, the cold tail was not testable.{% endif %}{% if verdict and verdict.family == 'better_cold_untested' %} For the family, the cold tail was not testable.{% endif %}{% endmacro %}
{% macro status_line(status, verdict, Y) %}{% if status == 'candidate' %}**Status: candidate.** Chosen on {{ Y.first }}–{{ Y.last }} (in sample for the choice), shown on {{ Y.seen }} seen by the developers; the held-out test, {{ Y.held }}, is pending.{% elif status == 'both_better' %}**Status: the terms lower the noon forecast's hourly error in the peak-event windows, and the additive model lowers it against v1's form, on held-out data ({{ Y.held }}).**{{ cold_clause(verdict) }}{% elif status == 'terms_only' %}**Status: the terms lower the noon forecast's hourly error in the peak-event windows, on held-out data ({{ Y.held }}); the additive model not shown better than v1's form.**{{ cold_clause(verdict) }}{% elif status == 'family_only' %}**Status: the terms not shown to lower the noon forecast's hourly error in the peak-event windows; the additive model lowers it against v1's form, on held-out data ({{ Y.held }}).**{{ cold_clause(verdict) }}{% elif status == 'neither' %}**Status: neither the terms nor the additive model shown to lower the noon forecast's hourly error on held-out data ({{ Y.held }}).**{% elif status == 'post_hoc' %}**Status: post hoc.** The {{ Y.held }} test of record is post hoc (section 4): it supports no claim on held-out data.{% elif status == 'unfinished' %}**Status: unfinished.** The {{ Y.held }} test of record started and did not finish (section 4): no claim.{% else %}{{ unknown_status }}{% endif %}{% endmacro %}
{% macro recommendation_line(kinds) %}**Recommendation, in the monitor's form: {% for k in kinds %}{{ RECOMMENDATION[k] }}{% if k == 'keep_v2_noon' %} (the noon forecast without the terms){% endif %}{% if not loop.last %}; {% endif %}{% endfor %}.** Every claim this verdict bears on is withdrawn. Nothing switches on its own: the model in use afterwards is the owner's ruling.{% endmacro %}
